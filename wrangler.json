{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foodnutritioncalculator-com",
  "compatibility_date": "2024-04-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "foodnutritioncalculator.com",
      "zone_name": "foodnutritioncalculator.com",
      "custom_domain": true
    },
    {
      "pattern": "www.foodnutritioncalculator.com",
      "zone_name": "foodnutritioncalculator.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "fa488924f911495bbbbf8b6f3154ad5d"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fnc-community",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "fnc-community-photos"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "REFERRAL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
