---
import SiteLayout from '../layouts/SiteLayout.astro';

import HomeHero from '../components/home/HomeHero.astro';
import HomeToolsGrid from '../components/home/HomeToolsGrid.astro';
import VegetarianIntelligence from '../components/home/VegetarianIntelligence.astro';
import SourceTruthHierarchy from '../components/home/SourceTruthHierarchy.astro';
import RecipeWorkflow from '../components/home/RecipeWorkflow.astro';
import MealDashboardPreview from '../components/home/MealDashboardPreview.astro';
import CompareFoodsPreview from '../components/home/CompareFoodsPreview.astro';
import NutritionLabelPreview from '../components/home/NutritionLabelPreview.astro';
import LearnTrustSection from '../components/home/LearnTrustSection.astro';
import HomeCTA from '../components/home/HomeCTA.astro';

import { buildWebSiteSchema, buildOrganizationSchema } from '../lib/seo/schema';

const seo = {
  title: "Food Nutrition Calculator | Calories, Macros & Nutrition Facts",
  description: "Calculate food calories, macros, recipe nutrition, meal totals, and food comparisons with USDA-first data and transparent source labels."
};

const jsonLd = [buildWebSiteSchema(), buildOrganizationSchema()];
---

<SiteLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <HomeHero />
  <HomeToolsGrid />
  <VegetarianIntelligence />
  <SourceTruthHierarchy />
  <RecipeWorkflow />
  <MealDashboardPreview />
  <CompareFoodsPreview />
  <NutritionLabelPreview />
  <LearnTrustSection />
  <HomeCTA />
</SiteLayout>
