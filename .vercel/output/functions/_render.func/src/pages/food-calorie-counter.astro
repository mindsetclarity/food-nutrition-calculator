---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/placeholders/PageHeader.astro';
import ToolPlaceholder from '../components/placeholders/ToolPlaceholder.astro';
---
<SiteLayout title="Food Calorie Counter - Fast Nutrition Search" noindex={true}>
  <PageHeader 
    title="Food Calorie Counter" 
    description="Look up calories and macros for any food instantly." 
    breadcrumbs={[{ label: 'Calorie Counter' }]} 
  />
  <ToolPlaceholder title="Calorie Counter" futureFeatures={[
    "Lightning-fast search",
    "Serving size adjustments",
    "Basic macronutrient pie charts",
    "Recent searches cache"
  ]} />
</SiteLayout>
