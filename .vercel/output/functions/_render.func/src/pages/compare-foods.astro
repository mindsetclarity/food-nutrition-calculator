---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import CompareFoodsShell from '../components/compare/CompareFoodsShell.astro';
import { buildSoftwareApplicationSchema } from '../lib/seo/schema';
import { siteConfig } from '../lib/seo/siteConfig';

const title = "Compare Foods | Side-by-Side Nutrition Comparison";
const description = "Compare calories, protein, carbs, fat, and micronutrients of two foods side-by-side using USDA-first nutrition data.";

const jsonLd = buildSoftwareApplicationSchema({
  name: "Compare Foods",
  description: description,
  url: `${siteConfig.siteUrl}/compare-foods`
});
---

<SiteLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHeader 
    title="Compare Foods" 
    description="See exactly how two foods differ in calories and macros. No judgments, just deterministic facts." 
    breadcrumbs={[{ label: 'Compare Foods' }]} 
    chipType="compare"
  />
  <CompareFoodsShell />
</SiteLayout>
