{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/500/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/foods/details/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/foods/llm-estimate/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/foods/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/llm/health/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/parse-meal/?$",
			"dest": "_render"
		},
		{
			"src": "^/calculator/?$",
			"dest": "_render"
		},
		{
			"src": "^/compare-foods/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/data-sources/?$",
			"dest": "_render"
		},
		{
			"src": "^/disclaimer/?$",
			"dest": "_render"
		},
		{
			"src": "^/food-calorie-counter/?$",
			"dest": "_render"
		},
		{
			"src": "^/foods/?$",
			"dest": "_render"
		},
		{
			"src": "^/learn/?$",
			"dest": "_render"
		},
		{
			"src": "^/meal-calorie-calculator/?$",
			"dest": "_render"
		},
		{
			"src": "^/methodology/?$",
			"dest": "_render"
		},
		{
			"src": "^/privacy/?$",
			"dest": "_render"
