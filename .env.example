# Free key from https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

LLM_PROVIDER=mock
LLM_MODEL=mock-food-parser
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=1200

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# NVIDIA NIM (Nemotron). Key from https://build.nvidia.com - set LLM_PROVIDER=nemotron to use it.
NVIDIA_API_KEY=your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter (NVIDIA Nemotron). Key from https://openrouter.ai/keys - set LLM_PROVIDER=openrouter to use it.
# Default is the free Super route: 3/3 meal parses in 3-4s when tested. Free models are rate limited
# (20/min; 50/day, or 1000/day once $10 of credits is purchased) and requests may be logged by the host.
# With credits, drop :free, or use nvidia/nemotron-3-ultra-550b-a55b for the largest model.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
