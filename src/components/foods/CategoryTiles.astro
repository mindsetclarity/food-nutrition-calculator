---
import { getAllCategories } from '../../lib/foods/categories';

interface Props {
  exclude?: string;
}
const { exclude } = Astro.props;
const categories = getAllCategories().filter(c => c.slug !== exclude);
---
<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
  {categories.map(c => (
    <li>
      <a href={`/foods/category/${c.slug}`} class="flex justify-between items-center gap-3 px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 font-semibold text-gray-800 hover:border-emerald-500 hover:text-emerald-700 transition-colors">
        <span>{c.name}</span>
        <span class="text-sm font-normal text-gray-500 tabular-nums">{c.foods.length}</span>
      </a>
    </li>
  ))}
</ul>
