---
---
<div class="mb-8">
  <label for="directory-search" class="sr-only">Search directory</label>
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
      <svg class="h-5 w-5 text-soft-slate" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
    </div>
    <input 
      type="search" 
      id="directory-search" 
      class="block w-full pl-12 pr-4 h-14 text-[15px] border border-border-soft rounded-[var(--radius-button)] bg-white focus-premium transition-shadow text-ink-navy placeholder-soft-slate shadow-sm" 
      placeholder="Filter foods..."
    >
  </div>
</div>

<div id="load-more-container" class="mt-8 text-center hidden">
  <button id="load-more-btn" class="px-6 py-3 bg-white border border-border-soft rounded-[var(--radius-button)] text-sm font-bold text-ink-navy hover:bg-surface-off-white hover:text-usda-emerald transition-colors shadow-sm">
    Load More Foods
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('directory-search') as HTMLInputElement;
    const foodCards = document.querySelectorAll('.food-card');
    const emptyState = document.getElementById('food-empty-state');
    const loadMoreContainer = document.getElementById('load-more-container');
    const loadMoreBtn = document.getElementById('load-more-btn');
    
    let currentLimit = 100;
    let currentQuery = '';
    
    function renderCards() {
      let matchCount = 0;
      let visibleCount = 0;
      
      foodCards.forEach(card => {
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const category = (card.getAttribute('data-category') || '').toLowerCase();
        
        if (name.includes(currentQuery) || category.includes(currentQuery)) {
          matchCount++;
          if (visibleCount < currentLimit) {
            (card as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
      
      if (emptyState) {
        if (matchCount === 0 && currentQuery.length > 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
      
      if (loadMoreContainer) {
        if (visibleCount < matchCount) {
          loadMoreContainer.classList.remove('hidden');
        } else {
          loadMoreContainer.classList.add('hidden');
        }
      }
    }
    
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        currentLimit = 100; // Reset limit on new search
        renderCards();
      });
    }
    
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        currentLimit += 100;
        renderCards();
      });
    }
    
    // Initial render
    renderCards();
  });
</script>
