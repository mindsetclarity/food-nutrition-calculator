---
import type { FoodItem } from '../../lib/nutrition/types';
import { formatGrams, portionRows } from '../../lib/foods/portions';

interface Props {
  food: FoodItem;
}

const { food } = Astro.props;
const rows = portionRows(food);
---
<div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 h-full">
  <h3 class="text-lg font-bold text-gray-900 mb-4">Calories by Portion</h3>
  <table class="w-full text-left">
    <caption class="sr-only">Calories and protein in common portions of {food.displayName}</caption>
    <thead>
      <tr class="border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500">
        <th scope="col" class="py-2 pr-2 font-semibold">Portion</th>
        <th scope="col" class="py-2 px-2 font-semibold text-right">Calories</th>
        <th scope="col" class="py-2 pl-2 font-semibold text-right">Protein</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      {rows.map(row => (
        <tr>
          <th scope="row" class="py-3 pr-2 font-medium text-gray-700">
            {row.label}{row.label !== `${row.grams} g` && <span class="block text-xs font-normal text-gray-500">{formatGrams(row.grams)} g</span>}
          </th>
          <td class="py-3 px-2 text-right tabular-nums font-semibold text-gray-900">{row.calories != null ? <>{row.calories}<span class="font-normal text-gray-500 text-sm"> kcal</span></> : <><span aria-hidden="true">—</span><span class="sr-only">not available</span></>}</td>
          <td class="py-3 pl-2 text-right tabular-nums text-gray-700">{row.protein != null ? `${row.protein} g` : <><span aria-hidden="true">—</span><span class="sr-only">not available</span></>}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="text-xs text-gray-500 mt-4 border-t border-gray-100 pt-4">
    Worked out from the per-100 g values. Portion weights vary by brand, size and preparation.
  </p>
</div>
