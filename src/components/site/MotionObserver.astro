<script>
  // A lightweight IntersectionObserver to handle scroll reveals globally.
  // It looks for elements with the `data-reveal` attribute.
  
  document.addEventListener('DOMContentLoaded', () => {
    // Check if the user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) {
      // If they prefer reduced motion, just show everything immediately and don't set up observer.
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        el.classList.remove('reveal-hidden');
      });
      return;
    }

    // Set initial state for elements to be revealed
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.classList.add('reveal-hidden');
    });

    // Create the observer
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            
            // Check for a delay
            const delay = el.getAttribute('data-reveal-delay');
            if (delay) {
              el.style.transitionDelay = `${delay}ms`;
            }
            
            // Reveal the element
            el.classList.remove('reveal-hidden');
            el.classList.add('reveal-visible');
            
            // Unobserve after revealing to prevent repeated animations (which can be annoying)
            observer.unobserve(el);
          }
        });
      }, {
        root: null,
        rootMargin: '0px 0px -50px 0px', // Trigger slightly before it hits the bottom
        threshold: 0.05
      });

      // Observe all tagged elements
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        observer.observe(el);
      });
    } else {
      // Fallback for very old browsers: just show everything
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        el.classList.remove('reveal-hidden');
      });
    }
  });
</script>
