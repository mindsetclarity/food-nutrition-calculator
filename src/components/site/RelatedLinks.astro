---
// "Related tools and guides": same-topic calculators, articles and charts from
// the topic cluster map. Renders nothing when the page is in no cluster.
import { getRelated, TOOL_NAMES, type RelatedKind } from '../../lib/topicClusters';
import { getLearnArticleBySlug } from '../../lib/learn/articleData';
import { CATEGORY_INTROS } from '../../data/categoryIntros';

interface Props {
  kind: RelatedKind;
  id: string;
  skip?: string[];
}
const { kind, id, skip = [] } = Astro.props;
const related = getRelated(kind, id, skip);

const groups = [
  { heading: 'Calculators', links: related.tools.map(path => ({ href: path, label: TOOL_NAMES[path] })) },
  { heading: 'Guides', links: related.articles.flatMap(slug => {
    const article = getLearnArticleBySlug(slug);
    return article ? [{ href: `/learn/${slug}`, label: article.title }] : [];
  }) },
  { heading: 'Calorie charts', links: related.charts.map(slug => ({ href: `/foods/category/${slug}`, label: CATEGORY_INTROS[slug].heading })) },
].filter(g => g.links.length);
const cols = ['', '', 'sm:grid-cols-2', 'sm:grid-cols-3'][groups.length];
const headingId = `related-${kind}`;
---
{groups.length > 0 && (
  <section aria-labelledby={headingId} class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
    <h2 id={headingId} class="text-2xl font-black text-gray-900 mb-4">Related tools and guides</h2>
    <div class:list={['grid gap-6', cols]}>
      {groups.map(g => (
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wide text-gray-500 mb-2">{g.heading}</h3>
          <ul class="space-y-2">
            {g.links.map(l => <li><a href={l.href} class="text-emerald-700 font-semibold hover:underline">{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
