---
import Layout from '../../layouts/SiteLayout.astro';
import TrustHero from './TrustHero.astro';
import TrustCTASection from './TrustCTASection.astro';
import { buildWebPageSchema } from '../../lib/seo/schema';
import { siteConfig } from '../../lib/seo/siteConfig';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  badges?: string[];
  updatedAt?: string;
  showCta?: boolean;
}

const { title, description, eyebrow, badges = [], updatedAt, showCta = true } = Astro.props;

const jsonLd = buildWebPageSchema({
  name: title,
  description: description,
  url: `${siteConfig.siteUrl}${Astro.url.pathname}`
});

---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-warm-ivory pb-24">
    <TrustHero title={title} description={description} eyebrow={eyebrow} badges={badges} updatedAt={updatedAt} />
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="prose prose-emerald prose-lg max-w-none text-ink-navy">
        <slot />
      </div>
    </div>
    
    {showCta && <TrustCTASection />}
  </main>
</Layout>
