---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---
<section id={id} class="legal-section">
  <h2 class="text-2xl font-black text-ink-navy m-0">{heading}</h2>
  <div class="space-y-4 text-soft-slate leading-relaxed text-[17px]">
    <slot />
  </div>
</section>
