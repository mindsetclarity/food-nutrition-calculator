---
interface Props {
  title: string;
  icon?: string;
  class?: string;
}

const { title, icon, class: className = '' } = Astro.props;
---

<div class={`bg-white border border-border-soft rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow h-full flex flex-col ${className}`}>
  <div class="flex items-center mb-4">
    {icon && (
      <div class="flex-shrink-0 w-10 h-10 rounded-full bg-mint-wash flex items-center justify-center text-usda-emerald font-bold mr-3">
        <span set:html={icon} />
      </div>
    )}
    <h3 class="text-xl font-bold text-ink-navy m-0 leading-tight">{title}</h3>
  </div>
  <div class="text-soft-slate text-[15px] leading-relaxed flex-grow">
    <slot />
  </div>
</div>
