---
---
<section id="how-it-works" class="py-24 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">
        How it works
      </h2>
      <p class="text-[var(--color-body)] text-lg max-w-2xl mx-auto">
        Build your meal and see instant nutrition facts. It's really that simple.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Step 1 -->
      <div class="bg-[var(--color-canvas)] rounded-xl p-8 border border-[var(--color-hairline)] shadow-[var(--shadow-level-2)]">
        <div class="w-12 h-12 rounded-full bg-[var(--color-canvas-soft)] flex items-center justify-center font-mono font-bold text-lg mb-6 border border-[var(--color-hairline)]">
          1
        </div>
        <h3 class="text-xl font-semibold text-[var(--color-ink)] mb-3">Select a food</h3>
        <p class="text-[var(--color-body)] leading-relaxed">
          Search for an ingredient from our curated local database of common everyday foods.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="bg-[var(--color-canvas)] rounded-xl p-8 border border-[var(--color-hairline)] shadow-[var(--shadow-level-2)]">
        <div class="w-12 h-12 rounded-full bg-[var(--color-canvas-soft)] flex items-center justify-center font-mono font-bold text-lg mb-6 border border-[var(--color-hairline)]">
          2
        </div>
        <h3 class="text-xl font-semibold text-[var(--color-ink)] mb-3">Enter quantity</h3>
        <p class="text-[var(--color-body)] leading-relaxed">
          Specify how much you are having using convenient units like bowls, cups, pieces, or grams.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="bg-[var(--color-canvas)] rounded-xl p-8 border border-[var(--color-hairline)] shadow-[var(--shadow-level-2)]">
        <div class="w-12 h-12 rounded-full bg-[var(--color-canvas-soft)] flex items-center justify-center font-mono font-bold text-lg mb-6 border border-[var(--color-hairline)]">
          3
        </div>
        <h3 class="text-xl font-semibold text-[var(--color-ink)] mb-3">Add to meal</h3>
        <p class="text-[var(--color-body)] leading-relaxed">
          Stack multiple items together to build a complete recipe or track an entire meal.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="bg-black rounded-xl p-8 border border-gray-800 shadow-[var(--shadow-level-3)] text-white relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 to-purple-600/20"></div>
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-full bg-gray-900 flex items-center justify-center font-mono font-bold text-lg mb-6 border border-gray-800">
            4
          </div>
          <h3 class="text-xl font-semibold text-white mb-3">View total nutrition</h3>
          <p class="text-gray-400 leading-relaxed">
            Instantly see your total calories, protein, carbs, fat, and fiber combined.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
