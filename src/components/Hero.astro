---
---
<section class="relative pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]">
  <!-- Soft mesh-like gradient background -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden opacity-30">
    <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-blue-400 mix-blend-multiply filter blur-[100px] opacity-50 animate-blob"></div>
    <div class="absolute top-[10%] -right-[10%] w-[40%] h-[40%] rounded-full bg-purple-400 mix-blend-multiply filter blur-[100px] opacity-50 animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-[20%] left-[20%] w-[60%] h-[60%] rounded-full bg-cyan-300 mix-blend-multiply filter blur-[100px] opacity-50 animate-blob animation-delay-4000"></div>
  </div>

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-[var(--color-body)] text-xs mb-8">
      <span class="w-2 h-2 rounded-full bg-[var(--color-link)]"></span>
      Fast, simple, privacy-friendly
    </div>
    
    <h1 class="text-4xl md:text-6xl font-semibold text-[var(--color-ink)] mb-6 tracking-[-0.05em] leading-tight text-balance mx-auto max-w-4xl">
      Calculate calories and macros in <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">seconds.</span>
    </h1>
    
    <p class="text-lg md:text-xl text-[var(--color-body)] mb-10 max-w-2xl mx-auto text-balance">
      Calculate calories, protein, carbs, fat, and more for everyday foods, meals, and recipes. No login required.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#calculator" class="w-full sm:w-auto px-8 py-4 rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] font-medium text-lg hover:bg-black transition-transform hover:scale-105 active:scale-95 shadow-[var(--shadow-level-2)]">
        Start Calculating
      </a>
      <a href="#how-it-works" class="w-full sm:w-auto px-8 py-4 rounded-full bg-[var(--color-canvas)] text-[var(--color-ink)] border border-[var(--color-hairline)] font-medium text-lg hover:bg-[var(--color-canvas-soft)] transition-colors">
        How it works
      </a>
    </div>
  </div>
</section>
