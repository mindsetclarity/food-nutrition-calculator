---
<div class="mb-10">
  <div class="flex items-center gap-3 mb-4">
    <h3 class="text-[11px] uppercase tracking-widest font-bold text-ink-navy">Quick Start Examples</h3>
    <div class="h-px bg-border-soft flex-1"></div>
  </div>
  <div class="flex flex-wrap gap-3">
    <button type="button" class="meal-example-btn group inline-flex items-center px-4 py-2 bg-white border border-border-soft rounded-[var(--radius-button)] text-[13px] font-bold text-ink-navy hover:bg-slate-50 transition-colors shadow-sm" data-example-id="breakfast_oatmeal">
      <span class="mr-2 text-lg group-hover:scale-110 transition-transform">🥣</span>
      Oatmeal Breakfast
    </button>
    <button type="button" class="meal-example-btn group inline-flex items-center px-4 py-2 bg-white border border-border-soft rounded-[var(--radius-button)] text-[13px] font-bold text-ink-navy hover:bg-slate-50 transition-colors shadow-sm" data-example-id="lunch_salad">
      <span class="mr-2 text-lg group-hover:scale-110 transition-transform">🥗</span>
      Chickpea Salad Lunch
    </button>
    <button type="button" class="meal-example-btn group inline-flex items-center px-4 py-2 bg-white border border-border-soft rounded-[var(--radius-button)] text-[13px] font-bold text-ink-navy hover:bg-slate-50 transition-colors shadow-sm" data-example-id="snack_yogurt">
      <span class="mr-2 text-lg group-hover:scale-110 transition-transform">🥑</span>
      Avocado Toast Snack
    </button>
  </div>
</div>
