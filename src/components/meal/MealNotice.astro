<div id="meal-notice" class="hidden mb-8 bg-amber-50 rounded-[var(--radius-card)] p-6 border border-amber-200">
  <div class="flex items-start">
    <div class="flex-shrink-0">
      <svg class="h-6 w-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>
    <div class="ml-4">
      <h3 class="text-[13px] font-bold text-amber-800 uppercase tracking-widest mb-2">Attention Required</h3>
      <div class="mt-2 text-[14px] font-medium text-amber-700">
        <ul id="meal-warnings-list" class="list-disc pl-5 space-y-1"></ul>
      </div>
    </div>
  </div>
</div>
