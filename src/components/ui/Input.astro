---
interface Props {
  id: string;
  label?: string;
  type?: 'text' | 'number' | 'email' | 'search';
  placeholder?: string;
  value?: string;
  class?: string;
  required?: boolean;
}

const { 
  id, 
  label, 
  type = 'text', 
  placeholder, 
  value, 
  class: className = '',
  required = false,
  ...rest 
} = Astro.props;
---

<div class={`w-full ${className}`}>
  {label && (
    <label for={id} class="block text-sm font-medium text-slate-700 mb-1">
      {label} {required && <span class="text-danger-text">*</span>}
    </label>
  )}
  <input
    type={type}
    id={id}
    name={id}
    placeholder={placeholder}
    value={value}
    required={required}
    class="block w-full rounded-md border-slate-300 shadow-sm focus-ring sm:text-sm px-4 py-2 border bg-white text-slate-900 placeholder-slate-400"
    {...rest}
  />
</div>
