---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<div class={`mb-8 ${className}`}>
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{title}</h2>
  {description && <p class="mt-2 text-lg text-slate-600">{description}</p>}
</div>
