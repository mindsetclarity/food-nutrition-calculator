---
interface Props {
  value: number;
  max: number;
  color: string;
  label: string;
  subtext: string;
  size?: number;
  strokeWidth?: number;
}

const { value, max, color, label, subtext } = Astro.props;

const radius = 40;
const circumference = 2 * Math.PI * radius;
const percent = Math.min(value / max, 1);
const offset = circumference - percent * circumference;
---

<div class="macro-card">
  <div class="macro-ring" aria-hidden="true">
    <svg class="macro-ring__svg" viewBox="0 0 100 100">
      <circle class="macro-ring__track" cx="50" cy="50" r="40" />
      <circle 
        class="macro-ring__progress" 
        cx="50" 
        cy="50" 
        r="40" 
        style={`stroke: ${color}; stroke-dasharray: ${circumference}; stroke-dashoffset: ${offset};`}
      />
    </svg>
    <span class="macro-ring__number">{value}</span>
  </div>

  <div class="macro-card__label">{label}</div>
  <div class="macro-card__amount">{subtext}</div>
</div>

<style>
.macro-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 190px;
  padding: 1.5rem;
  text-align: center;
}

.macro-ring {
  position: relative;
  width: 92px;
  height: 92px;
  display: grid;
  place-items: center;
  margin-inline: auto;
  margin-bottom: 0.75rem;
}

.macro-ring__svg {
  position: absolute;
  inset: 0;
  width: 92px;
  height: 92px;
  display: block;
  transform: rotate(-90deg);
  transform-origin: center;
}

.macro-ring__track {
  fill: none;
  stroke: var(--color-border-soft, rgba(15, 23, 42, 0.1));
  stroke-width: 7;
}

.macro-ring__progress {
  fill: none;
  stroke-width: 7;
  stroke-linecap: round;
  transition: stroke-dashoffset 1s ease-out;
}

.macro-ring__number {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  line-height: 1;
  font-weight: 800;
  font-size: 1.15rem;
  color: var(--color-ink-navy, #0B1020);
}

.macro-card__label {
  margin-top: 0.1rem;
  font-size: 0.78rem;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-muted-text, #64748B);
}

.macro-card__amount {
  margin-top: 0.6rem;
  line-height: 1;
  font-size: 1rem;
  font-weight: 800;
  color: var(--color-ink-navy, #0B1020);
}
</style>
