---
import { siteConfig } from '../../lib/seo/siteConfig';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---
<a href={siteConfig.playStoreUrl} target="_blank" rel="noopener" aria-label="Get it on Google Play" class:list={['inline-flex items-center gap-3 px-5 py-2.5 rounded-xl bg-ink-navy text-white border border-white/20 shadow-ink hover:shadow-premium hover:-translate-y-px transition focus-ring', className]}>
  <svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#00d2ff" d="M3.6 1.6c-.3.3-.5.8-.5 1.4v18c0 .6.2 1.1.5 1.4l.1.1L13.8 12v-.2z"/><path fill="#ffce00" d="M17.2 15.4 13.8 12v-.2l3.4-3.4.1.1 4 2.3c1.1.6 1.1 1.7 0 2.4l-4 2.3z"/><path fill="#f43d4f" d="m17.3 15.3-3.5-3.5L3.6 22c.4.4 1 .4 1.7.1z"/><path fill="#00f076" d="M17.3 8.3 5.3 1.9C4.6 1.5 4 1.6 3.6 2l10.2 10z"/></svg>
  <span class="flex flex-col text-left leading-tight">
    <span class="text-[10px] uppercase tracking-wide opacity-80">Get it on</span>
    <span class="text-lg font-semibold">Google Play</span>
  </span>
</a>
