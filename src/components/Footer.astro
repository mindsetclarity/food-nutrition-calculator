---
---
<footer class="bg-[var(--color-canvas)] border-t border-[var(--color-hairline)] py-12 mt-auto">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 flex flex-col md:flex-row items-start justify-between gap-8">
    <div class="max-w-xs">
      <a href="/" class="font-semibold text-lg tracking-tight mb-4 inline-block">
        Food Nutrition Calculator
      </a>
      <p class="text-[var(--color-body)] text-sm mb-4">
        Simple, fast, and privacy-friendly. Calculate nutrition for your favorite foods, meals, and recipes without logging in.
      </p>
      <p class="text-[var(--color-mute)] text-xs">
        &copy; {new Date().getFullYear()} foodnutritioncalculator.com
      </p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-3 gap-8 text-sm">
      <div>
        <h3 class="font-medium text-[var(--color-ink)] mb-3">Product</h3>
        <ul class="flex flex-col gap-2 text-[var(--color-body)]">
          <li><a href="#calculator" class="hover:text-[var(--color-ink)]">Calculator</a></li>
          <li><a href="#foods" class="hover:text-[var(--color-ink)]">Food Database</a></li>
          <li><a href="#how-it-works" class="hover:text-[var(--color-ink)]">How it works</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-medium text-[var(--color-ink)] mb-3">Legal & Info</h3>
        <ul class="flex flex-col gap-2 text-[var(--color-body)]">
          <li><a href="#disclaimer" class="hover:text-[var(--color-ink)]">Disclaimer</a></li>
          <li><a href="#faq" class="hover:text-[var(--color-ink)]">FAQ</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
