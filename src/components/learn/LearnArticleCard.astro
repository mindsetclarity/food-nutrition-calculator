---
import type { LearnArticle } from '../../lib/learn/types';

interface Props {
  article: LearnArticle;
}

const { article } = Astro.props;
---
<a href={`/learn/${article.slug}`} class="group flex flex-col h-full bg-white rounded-3xl overflow-hidden interactive-card focus:outline-none">
  <div class="p-6 sm:p-8 flex-grow flex flex-col">
    <div class="flex items-center space-x-3 mb-4">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700">
        {article.category}
      </span>
      <span class="text-xs font-medium text-gray-400 flex items-center">
        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        {article.readingTimeMinutes} min read
      </span>
    </div>
    
    <h3 class="text-xl font-black text-gray-900 mb-3 group-hover:text-emerald-700 transition-colors line-clamp-2">
      {article.title}
    </h3>
    
    <p class="text-gray-600 line-clamp-3 mb-6 text-sm sm:text-base flex-grow">
      {article.description}
    </p>
    
    <div class="mt-auto pt-4 border-t border-gray-100 flex items-center text-sm font-bold text-emerald-600 group-hover:text-emerald-700 transition-colors">
      Read Guide
      <svg class="w-4 h-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
    </div>
  </div>
</a>
