---
import type { LearnArticleFAQ as FAQType } from '../../lib/learn/types';

interface Props {
  faqs: FAQType[];
}

const { faqs } = Astro.props;
---
<section id="faq" class="mt-16 pt-12 border-t border-gray-200 scroll-mt-24">
  <h2 class="text-2xl font-black text-gray-900 mb-8">Frequently Asked Questions</h2>
  
  <div class="space-y-6">
    {faqs.map(faq => (
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-100 shadow-sm">
        <h3 class="text-lg font-bold text-gray-900 mb-3">{faq.question}</h3>
        <p class="text-gray-700 leading-relaxed">{faq.answer}</p>
      </div>
    ))}
  </div>
</section>
