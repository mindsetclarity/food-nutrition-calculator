---
import type { LearnArticleCallout as CalloutType } from '../../lib/learn/types';

interface Props {
  callout: CalloutType;
}

const { callout } = Astro.props;

let bg = 'bg-gray-50';
let border = 'border-gray-200';
let iconColor = 'text-gray-500';
let titleColor = 'text-gray-900';
let icon = '';

if (callout.tone === 'info') {
  bg = 'bg-blue-50';
  border = 'border-blue-200';
  iconColor = 'text-blue-500';
  titleColor = 'text-blue-900';
  icon = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>';
} else if (callout.tone === 'warning') {
  bg = 'bg-amber-50';
  border = 'border-amber-200';
  iconColor = 'text-amber-500';
  titleColor = 'text-amber-900';
  icon = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>';
} else if (callout.tone === 'trust') {
  bg = 'bg-emerald-50';
  border = 'border-emerald-200';
  iconColor = 'text-emerald-500';
  titleColor = 'text-emerald-900';
  icon = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>';
}
---
<div class={`my-8 p-5 sm:p-6 rounded-2xl border ${bg} ${border}`}>
  <div class="flex items-start">
    <svg class={`w-6 h-6 ${iconColor} mt-0.5 flex-shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icon}></svg>
    <div class="ml-3">
      <h4 class={`text-base font-bold ${titleColor} mb-1`}>{callout.title}</h4>
      <p class={`text-sm sm:text-base ${titleColor} opacity-90 leading-relaxed`}>{callout.body}</p>
    </div>
  </div>
</div>
