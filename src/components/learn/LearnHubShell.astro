---
import Layout from '../../layouts/Layout.astro';
import LearnArticleCard from './LearnArticleCard.astro';
import Button from '../ui/Button.astro';

import { 
  getAllLearnArticles, 
  getLearnHubSeo
} from '../../lib/learn';

const allArticles = getAllLearnArticles();
const featuredSlugs = ['how-to-calculate-calories-in-food', 'calories-vs-macros', 'how-recipe-nutrition-calculators-work', 'how-to-read-a-nutrition-facts-label'];
const featuredArticles = allArticles.filter(a => featuredSlugs.includes(a.slug));

const categories = [
  { name: 'Calories', desc: 'Learn how calorie estimates are calculated and why they can vary.', count: allArticles.filter(a => a.category === 'Calories').length },
  { name: 'Macros', desc: 'Understand protein, carbs, and fat in practical food tracking.', count: allArticles.filter(a => a.category === 'Macros').length },
  { name: 'Recipes', desc: 'Learn how ingredient lists become per-serving nutrition estimates.', count: allArticles.filter(a => a.category === 'Recipes').length },
  { name: 'Food Labels', desc: 'Understand Nutrition Facts-style labels and % Daily Value.', count: allArticles.filter(a => a.category === 'Food Labels').length },
  { name: 'Serving Sizes', desc: 'Learn the difference between serving size, portion size, grams, cups, and pieces.', count: allArticles.filter(a => a.category === 'Serving Sizes').length },
  { name: 'USDA Data', desc: 'Understand USDA-first data, local fallback, and source transparency.', count: allArticles.filter(a => a.category === 'USDA Data').length },
  { name: 'Meal Planning Basics', desc: 'Learn how meal and full-day totals are built.', count: allArticles.filter(a => a.category === 'Meal Planning Basics').length },
  { name: 'Food Comparison', desc: 'Compare foods carefully without calling one food universally healthier.', count: allArticles.filter(a => a.category === 'Food Comparison').length }
].filter(c => c.count > 0);

const seo = getLearnHubSeo();

import { buildWebPageSchema } from '../../lib/seo/schema';
import { siteConfig } from '../../lib/seo/siteConfig';

const jsonLd = buildWebPageSchema({
  name: seo.title,
  description: seo.description,
  url: `${siteConfig.siteUrl}/learn`
});
---

<Layout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-warm-ivory pb-24">
    
    <!-- 1. Hero Section -->
    <section class="bg-white border-b border-border-soft py-16 sm:py-24 overflow-hidden relative">
      <div class="absolute -right-24 -top-24 w-96 h-96 bg-mint-wash rounded-full opacity-40 blur-3xl pointer-events-none"></div>
      <div class="site-container relative z-10 text-center">
        <span class="text-xs font-bold text-usda-emerald tracking-wider uppercase mb-4 block">Nutrition Learning Hub</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-ink-navy tracking-tight mb-6 max-w-4xl mx-auto">
          Learn food nutrition without the confusion.
        </h1>
        <p class="text-lg sm:text-xl text-soft-slate max-w-3xl mx-auto mb-10 leading-relaxed">
          Beginner-friendly guides for calories, macros, serving sizes, Nutrition Facts-style labels, USDA data, recipes, meals, and food comparisons.
        </p>
        
        <div class="flex flex-wrap justify-center gap-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[13px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-100">
            Beginner friendly
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[13px] font-semibold bg-blue-50 text-blue-800 border border-blue-100">
            Tool connected
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[13px] font-semibold bg-amber-50 text-amber-800 border border-amber-100">
            Source aware
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[13px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
            Not medical advice
          </span>
        </div>
      </div>
    </section>

    <!-- Navigation / Jump Links (Desktop) -->
    <div class="sticky top-[72px] z-30 bg-warm-ivory/90 backdrop-blur-md border-b border-border-soft hidden md:block">
      <div class="site-container py-3">
        <nav class="flex justify-center space-x-8 text-sm font-semibold">
          <a href="#start-here" class="text-soft-slate hover:text-usda-emerald transition-colors">Start Here</a>
          <a href="#learning-path" class="text-soft-slate hover:text-usda-emerald transition-colors">Learning Path</a>
          <a href="#categories" class="text-soft-slate hover:text-usda-emerald transition-colors">Categories</a>
          <a href="#featured" class="text-soft-slate hover:text-usda-emerald transition-colors">Featured</a>
          <a href="#all-guides" class="text-soft-slate hover:text-usda-emerald transition-colors">All Guides</a>
        </nav>
      </div>
    </div>

    <!-- 2. Start Here Section -->
    <section id="start-here" class="site-container py-16 scroll-mt-24">
      <h2 class="text-2xl sm:text-3xl font-black text-ink-navy mb-8 text-center">Start here if you are new to nutrition tracking</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/learn/how-to-calculate-calories-in-food" class="luxury-card p-6 flex flex-col group">
          <span class="text-xs font-bold text-usda-emerald mb-2 uppercase tracking-wider">Step 1 &middot; Calories</span>
          <h3 class="text-xl font-bold text-ink-navy mb-3 group-hover:text-usda-emerald transition-colors">How calories are estimated</h3>
          <p class="text-sm text-soft-slate mb-6 flex-grow">Learn how calorie estimates are generated from macronutrients.</p>
          <div class="flex items-center justify-between mt-auto">
            <span class="text-[13px] font-semibold text-usda-emerald group-hover:underline">Read guide &rarr;</span>
            <span class="text-xs text-muted-text">4 min read</span>
          </div>
        </a>
        <a href="/learn/calories-vs-macros" class="luxury-card p-6 flex flex-col group">
          <span class="text-xs font-bold text-usda-emerald mb-2 uppercase tracking-wider">Step 2 &middot; Macros</span>
          <h3 class="text-xl font-bold text-ink-navy mb-3 group-hover:text-usda-emerald transition-colors">Calories vs macros explained</h3>
          <p class="text-sm text-soft-slate mb-6 flex-grow">Understand the difference between tracking total calories and tracking specific macronutrients.</p>
          <div class="flex items-center justify-between mt-auto">
            <span class="text-[13px] font-semibold text-usda-emerald group-hover:underline">Read guide &rarr;</span>
            <span class="text-xs text-muted-text">5 min read</span>
          </div>
        </a>
        <a href="/learn/serving-size-vs-portion-size" class="luxury-card p-6 flex flex-col group">
          <span class="text-xs font-bold text-usda-emerald mb-2 uppercase tracking-wider">Step 3 &middot; Serving Sizes</span>
          <h3 class="text-xl font-bold text-ink-navy mb-3 group-hover:text-usda-emerald transition-colors">Serving size vs portion size</h3>
          <p class="text-sm text-soft-slate mb-6 flex-grow">Learn the critical difference between standardized labels and the portions you eat.</p>
          <div class="flex items-center justify-between mt-auto">
            <span class="text-[13px] font-semibold text-usda-emerald group-hover:underline">Read guide &rarr;</span>
            <span class="text-xs text-muted-text">3 min read</span>
          </div>
        </a>
      </div>
    </section>

    <!-- 3. Learning Path Section -->
    <section id="learning-path" class="bg-white py-16 border-y border-border-soft scroll-mt-24">
      <div class="site-container">
        <h2 class="text-2xl sm:text-3xl font-black text-ink-navy mb-10 text-center">A simple path to understand your food</h2>
        <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between relative">
          <!-- Desktop line -->
          <div class="hidden md:block absolute top-6 left-12 right-12 h-0.5 bg-emerald-100 -z-10"></div>
          
          <div class="flex flex-col md:items-center text-center mb-8 md:mb-0 relative group">
            <div class="w-12 h-12 rounded-full bg-mint-wash border-2 border-usda-emerald text-usda-emerald font-bold text-lg flex items-center justify-center mx-auto mb-4 relative z-10 bg-white">1</div>
            <h4 class="font-bold text-ink-navy mb-2">Understand calories</h4>
            <p class="text-xs text-soft-slate max-w-[180px]">Learn what calories mean and why estimates vary.</p>
          </div>
          
          <div class="flex flex-col md:items-center text-center mb-8 md:mb-0 relative group">
            <div class="w-12 h-12 rounded-full bg-mint-wash border-2 border-usda-emerald text-usda-emerald font-bold text-lg flex items-center justify-center mx-auto mb-4 relative z-10 bg-white">2</div>
            <h4 class="font-bold text-ink-navy mb-2">Understand macros</h4>
            <p class="text-xs text-soft-slate max-w-[180px]">Learn protein, carbs, and fat without overcomplication.</p>
          </div>
          
          <div class="flex flex-col md:items-center text-center mb-8 md:mb-0 relative group">
            <div class="w-12 h-12 rounded-full bg-mint-wash border-2 border-usda-emerald text-usda-emerald font-bold text-lg flex items-center justify-center mx-auto mb-4 relative z-10 bg-white">3</div>
            <h4 class="font-bold text-ink-navy mb-2">Understand serving sizes</h4>
            <p class="text-xs text-soft-slate max-w-[180px]">Learn why 1 cup, 100g, and 1 serving can differ.</p>
          </div>
          
          <div class="flex flex-col md:items-center text-center mb-8 md:mb-0 relative group">
            <div class="w-12 h-12 rounded-full bg-mint-wash border-2 border-usda-emerald text-usda-emerald font-bold text-lg flex items-center justify-center mx-auto mb-4 relative z-10 bg-white">4</div>
            <h4 class="font-bold text-ink-navy mb-2">Read labels clearly</h4>
            <p class="text-xs text-soft-slate max-w-[180px]">Learn what Nutrition Facts-style labels show.</p>
          </div>
          
          <div class="flex flex-col md:items-center text-center relative group">
            <div class="w-12 h-12 rounded-full bg-emerald-600 border-2 border-emerald-600 text-white font-bold text-lg flex items-center justify-center mx-auto mb-4 relative z-10">5</div>
            <h4 class="font-bold text-ink-navy mb-2">Use tools confidently</h4>
            <p class="text-xs text-soft-slate max-w-[180px]">Search foods, analyze recipes, compare foods, and build meal totals.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Topic Categories Section -->
    <section id="categories" class="site-container py-16 scroll-mt-24">
      <h2 class="text-2xl sm:text-3xl font-black text-ink-navy mb-8 text-center">Topics</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <div class="bg-white border border-border-soft rounded-xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-bold text-ink-navy">{cat.name}</h3>
              <span class="text-[10px] font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{cat.count}</span>
            </div>
            <p class="text-[13px] text-soft-slate leading-relaxed">{cat.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Featured Guides Section -->
    <section id="featured" class="bg-mint-surface py-16 border-y border-border-soft scroll-mt-24">
      <div class="site-container">
        <h2 class="text-2xl sm:text-3xl font-black text-ink-navy mb-8 text-center">Featured guides</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredArticles.map(article => (
            <div class="bg-white border border-emerald-100 rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col sm:flex-row h-full">
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-center space-x-3 mb-3">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-usda-emerald uppercase tracking-wider border border-emerald-100">
                    {article.category}
                  </span>
                  <span class="text-xs font-medium text-soft-slate">
                    {article.readingTimeMinutes} min read
                  </span>
                </div>
                <h3 class="text-lg font-bold text-ink-navy mb-2 leading-tight">
                  {article.title}
                </h3>
                <p class="text-sm text-soft-slate mb-5 flex-grow line-clamp-2">
                  {article.description}
                </p>
                <div class="mt-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-gray-100">
                  <a href={`/learn/${article.slug}`} class="text-[13px] font-bold text-usda-emerald hover:underline flex items-center">
                    Read guide <span class="ml-1">&rarr;</span>
                  </a>
                  {article.relatedTool && (
                    <a href={article.relatedTool.href} class="text-[11px] font-medium text-soft-slate hover:text-ink-navy flex items-center bg-slate-50 px-2 py-1 rounded border border-slate-200 w-fit">
                      {article.relatedTool.label}
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. All Guides Section -->
    <section id="all-guides" class="site-container py-16 scroll-mt-24">
      <h2 class="text-2xl sm:text-3xl font-black text-ink-navy mb-8">All nutrition guides</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {allArticles.map(article => (
          <LearnArticleCard article={article} />
        ))}
      </div>
    </section>

    <!-- 7. Tool-connected learning Section -->
    <section class="bg-white py-16 border-t border-border-soft">
      <div class="site-container">
        <h2 class="text-2xl sm:text-3xl font-black text-ink-navy mb-8 text-center">Learn, then calculate</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <a href="/calculator" class="ivory-card p-5 group flex flex-col h-full">
            <h4 class="font-bold text-ink-navy mb-2">Learn calories</h4>
            <p class="text-xs text-soft-slate mb-4 flex-grow">Put it to practice by searching for foods.</p>
            <div class="mt-auto text-[13px] font-bold text-usda-emerald group-hover:underline">Use Food Calculator &rarr;</div>
          </a>
          <a href="/recipe-nutrition-calculator" class="ivory-card p-5 group flex flex-col h-full">
            <h4 class="font-bold text-ink-navy mb-2">Learn recipe nutrition</h4>
            <p class="text-xs text-soft-slate mb-4 flex-grow">Paste ingredients to see per-serving macros.</p>
            <div class="mt-auto text-[13px] font-bold text-usda-emerald group-hover:underline">Use Recipe Calculator &rarr;</div>
          </a>
          <a href="/meal-calorie-calculator" class="ivory-card p-5 group flex flex-col h-full">
            <h4 class="font-bold text-ink-navy mb-2">Learn meal totals</h4>
            <p class="text-xs text-soft-slate mb-4 flex-grow">Build a full day or plate to see totals.</p>
            <div class="mt-auto text-[13px] font-bold text-usda-emerald group-hover:underline">Use Meal Calculator &rarr;</div>
          </a>
          <a href="/compare-foods" class="ivory-card p-5 group flex flex-col h-full">
            <h4 class="font-bold text-ink-navy mb-2">Learn food comparison</h4>
            <p class="text-xs text-soft-slate mb-4 flex-grow">Compare foods normalized to 100g.</p>
            <div class="mt-auto text-[13px] font-bold text-usda-emerald group-hover:underline">Use Compare Foods &rarr;</div>
          </a>
        </div>
      </div>
    </section>

    <!-- 8. Trust/safety disclaimer -->
    <section class="site-container py-8 border-t border-border-soft">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 text-center max-w-4xl mx-auto">
        <p class="text-[13px] text-soft-slate leading-relaxed">
          <strong>Important:</strong> These guides are for general nutrition education and personal planning only. They are not medical advice. Nutrition values can vary by brand, preparation method, and serving size.
        </p>
        <div class="mt-3 flex justify-center space-x-4 text-xs font-medium">
          <a href="/methodology" class="text-muted-text hover:text-ink-navy underline">Methodology</a>
          <a href="/data-sources" class="text-muted-text hover:text-ink-navy underline">Data Sources</a>
          <a href="/disclaimer" class="text-muted-text hover:text-ink-navy underline">Disclaimer</a>
        </div>
      </div>
    </section>

    <!-- 9. Final CTA -->
    <section class="bg-ink-navy text-white py-16 sm:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-slate-800 to-ink-navy opacity-50"></div>
      <div class="site-container relative z-10 text-center">
        <h2 class="text-3xl sm:text-4xl font-black mb-4">Ready to calculate your own food?</h2>
        <p class="text-slate-300 max-w-2xl mx-auto mb-10 text-lg">
          Start with one food, a recipe, or a full meal. Results stay source-labeled and reviewable.
        </p>
        <div class="learn-final-cta__actions">
          <a href="/calculator" class="cta-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink-navy">
            Start Calculating
          </a>
          <a href="/recipe-nutrition-calculator" class="cta-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink-navy">
            Analyze a Recipe
          </a>
          <a href="/foods" class="cta-tertiary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink-navy">
            Browse Foods
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .learn-final-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .learn-final-cta__actions a {
    min-height: 3.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1.5rem;
    border-radius: 1rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  /* Primary: Emerald/Dark */
  .cta-primary {
    background-color: #10b981; /* emerald-500 */
    color: #ffffff;
    box-shadow: 0 4px 14px 0 rgba(16, 185, 129, 0.39);
    border: 1px solid transparent;
  }
  .cta-primary:hover, .cta-primary:active {
    background-color: #059669; /* emerald-600 */
    color: #ffffff;
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.23);
    transform: translateY(-1px);
  }

  /* Secondary: Light with dark text */
  .cta-secondary {
    background-color: #ffffff;
    color: #0f172a; /* slate-900 / ink-navy */
    border: 1px solid #e2e8f0;
  }
  .cta-secondary:hover, .cta-secondary:active {
    background-color: #f8fafc; /* slate-50 */
    color: #0f172a;
    border-color: #cbd5e1;
    transform: translateY(-1px);
  }

  /* Tertiary: Outline/transparent with white text */
  .cta-tertiary {
    background-color: transparent;
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .cta-tertiary:hover, .cta-tertiary:active {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 640px) {
    .learn-final-cta__actions {
      flex-direction: column;
      align-items: stretch;
    }
    
    .learn-final-cta__actions a {
      width: 100%;
    }
  }
</style>
