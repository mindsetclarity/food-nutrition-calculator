---
import type { NutritionLabelInput } from '../../lib/nutrition-label/types';
import { normalizeLabelNutrients, detectPartialData, getSourceWarnings, buildLabelRows } from '../../lib/nutrition-label/buildNutritionLabel';
import { formatCalories, formatServingLabel } from '../../lib/nutrition-label/formatLabelValue';

import NutritionFactsRow from './NutritionFactsRow.astro';
import NutritionFactsDivider from './NutritionFactsDivider.astro';
import NutritionFactsFootnote from './NutritionFactsFootnote.astro';
import NutritionFactsWarning from './NutritionFactsWarning.astro';

interface Props extends NutritionLabelInput {
  class?: string;
  compact?: boolean;
}

const { 
  title = "Nutrition Facts", 
  servingLabel, 
  servingsPerContainer, 
  nutrients: rawNutrients, 
  sourceSummary, 
  warnings = [], 
  class: className = "",
  compact = false
} = Astro.props;

const nutrients = normalizeLabelNutrients(rawNutrients);
const partialData = detectPartialData(nutrients);
const dynamicWarnings = getSourceWarnings(sourceSummary);
const allWarnings = [...warnings, ...dynamicWarnings];

const rows = buildLabelRows(nutrients);
const caloriesStr = formatCalories(nutrients.calories);
const finalServingLabel = formatServingLabel(servingLabel);
---
<div id="nutrition-label-container" class={`bg-white border border-gray-300 p-1 rounded-sm shadow-sm font-sans text-black w-full max-w-sm hidden ${className}`} aria-label="Nutrition Facts label preview">
  <div class="border border-black p-2 sm:p-4 bg-white">
    <h2 class="text-3xl sm:text-4xl font-black tracking-tighter m-0 mb-1 leading-none" id="label-title">{title}</h2>
    
    <p id="label-servings-per" class={`text-sm sm:text-base font-medium m-0 mb-1 leading-tight ${servingsPerContainer ? '' : 'hidden'}`}>
      {servingsPerContainer} servings per container
    </p>
    
    <div class="flex justify-between font-bold text-sm sm:text-base m-0 mb-2 leading-tight">
      <span>Serving size</span>
      <span id="label-serving-size">{finalServingLabel}</span>
    </div>
    
    <NutritionFactsDivider size="thick" />
    
    <div class="mt-1 mb-1">
      <p class="font-bold text-[10px] sm:text-xs m-0 leading-tight">Amount per serving</p>
      <div class="flex justify-between items-end">
        <h3 class="text-3xl sm:text-4xl font-black m-0 leading-none">Calories</h3>
        <span id="label-calories" class="text-3xl sm:text-4xl font-black m-0 leading-none">{caloriesStr}</span>
      </div>
    </div>
    
    <NutritionFactsDivider size="medium" />
    
    <div class="text-right text-xs font-bold py-1">
      % Daily Value*
    </div>
    
    <div id="label-rows-container">
      {rows.map(row => (
        <NutritionFactsRow {...row} />
      ))}
    </div>
    
    <NutritionFactsFootnote />
  </div>
  
  <div id="label-warnings-container">
    <NutritionFactsWarning warnings={allWarnings} partialData={partialData} />
  </div>
</div>

<script>
  import { calculatePercentDailyValue, getDailyValueForNutrient } from '../../lib/nutrition-label/percentDailyValue';
  import { formatCalories, formatNutritionAmount } from '../../lib/nutrition-label/formatLabelValue';
  import type { DailyValueKey } from '../../lib/nutrition-label/types';

  window.addEventListener('update-nutrition-label', (e: any) => {
    const { nutrients, servings, servingLabel, title } = e.detail;
    const container = document.getElementById('nutrition-label-container');
    if (!container) return;
    
    if (!nutrients || (nutrients.calories === null && nutrients.protein === null)) {
      container.classList.add('hidden');
      return;
    }
    
    container.classList.remove('hidden');
    
    if (title) {
      const titleEl = document.getElementById('label-title');
      if (titleEl) titleEl.textContent = title;
    }

    const servingsEl = document.getElementById('label-servings-per');
    if (servingsEl) {
      if (servings) {
        servingsEl.textContent = `${servings} servings per container`;
        servingsEl.classList.remove('hidden');
      } else {
        servingsEl.classList.add('hidden');
      }
    }
    
    const servingSizeEl = document.getElementById('label-serving-size');
    if (servingSizeEl) {
      servingSizeEl.textContent = servingLabel || '1 serving';
    }

    const calsEl = document.getElementById('label-calories');
    if (calsEl) {
      calsEl.textContent = formatCalories(nutrients.calories);
    }
    
    const rowsContainer = document.getElementById('label-rows-container');
    if (rowsContainer) {
      const rows = rowsContainer.querySelectorAll('[data-nutrient-row]');
      rows.forEach(row => {
        const key = row.getAttribute('data-nutrient-row');
        const amountEl = row.querySelector('.nutrient-amount');
        const dvEl = row.querySelector('.nutrient-dv');
        
        if (key && amountEl) {
          const val = nutrients[key];
          const unit = amountEl.getAttribute('data-unit') || 'g';
          
          if (val === null || val === undefined) {
             row.classList.add('hidden');
          } else {
             row.classList.remove('hidden');
             amountEl.textContent = formatNutritionAmount(val, unit);
             
             if (dvEl) {
                const dvKey = dvEl.getAttribute('data-dv-key');
                if (dvKey) {
                   const dv = getDailyValueForNutrient(dvKey as DailyValueKey);
                   const pct = calculatePercentDailyValue(val, dv);
                   if (pct !== null) {
                      dvEl.textContent = `${pct}%`;
                      dvEl.classList.remove('hidden');
                   } else {
                      dvEl.classList.add('hidden');
                   }
                }
             }
          }
        }
      });
    }
  });
</script>
