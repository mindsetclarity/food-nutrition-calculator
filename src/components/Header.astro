---
---
<header class="sticky top-0 z-50 bg-[var(--color-canvas)]/80 backdrop-blur-md border-b border-[var(--color-hairline)]">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-semibold text-lg tracking-tight flex items-center gap-2">
      <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      Food Nutrition Calculator
    </a>
    
    <nav class="hidden md:flex items-center gap-6 text-sm">
      <a href="#calculator" class="text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors">Calculator</a>
      <a href="#how-it-works" class="text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors">How it works</a>
      <a href="#faq" class="text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors">FAQ</a>
    </nav>
    
    <div class="flex items-center gap-4">
      <a href="#calculator" class="bg-[var(--color-primary)] text-[var(--color-on-primary)] hover:bg-[var(--color-primary)]/90 transition-colors px-4 py-2 rounded-full text-sm font-medium">
        Start Calculating
      </a>
    </div>
  </div>
</header>
