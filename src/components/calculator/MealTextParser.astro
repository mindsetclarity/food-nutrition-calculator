---
---
<div id="meal-parser-section" class="mb-8 p-6 md:p-8 border border-border-soft rounded-[var(--radius-card)] bg-slate-50 relative">
  <div class="mb-4">
    <h3 class="text-[11px] font-bold text-ink-navy uppercase tracking-widest mb-2 flex items-center gap-2">
      <svg class="w-4 h-4 text-usda-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      AI Parsing Assist
    </h3>
    <p class="text-[13px] text-soft-slate font-medium">Type a meal in normal English. We'll parse it into food items, match each item with USDA-first search, and let you review before adding.</p>
  </div>
  
  <form id="parser-form" class="relative mb-4">
    <label for="meal-text" class="sr-only">Meal description</label>
    <textarea id="meal-text" rows="3" placeholder="2 boiled eggs, 1 banana, 1 cup cooked oatmeal, and black coffee" class="w-full p-4 rounded-[var(--radius-button)] bg-white border border-border-soft text-ink-navy placeholder-soft-slate focus-premium transition-shadow shadow-sm resize-y text-[15px]"></textarea>
    
    <div class="flex items-center justify-between mt-3 gap-2">
      <div class="flex gap-2">
        <button type="button" id="parser-example-btn" class="text-[11px] font-bold tracking-wider uppercase text-usda-emerald hover:text-fresh-leaf hover:underline interactive-button px-2 py-1">Use example</button>
        <button type="button" id="parser-clear-btn" class="text-[11px] font-bold tracking-wider uppercase text-soft-slate hover:text-ink-navy hidden interactive-button px-2 py-1">Clear</button>
      </div>
      <button type="submit" id="parser-submit-btn" class="h-10 px-6 rounded-[var(--radius-button)] bg-ink-navy text-white text-sm font-medium hover:bg-deep-slate transition-colors disabled:opacity-50 shadow-sm interactive-button">
        Parse meal
      </button>
    </div>
  </form>

  <div id="parser-error" class="hidden text-[13px] font-medium text-red-700 bg-red-50 border border-red-100 p-3 rounded-[var(--radius-button)] mb-4"></div>
  
  <div id="parser-review-area" class="hidden">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-border-soft">
      <h4 class="text-sm font-bold text-ink-navy">Review Parsed Items</h4>
      <div id="parser-provider-notice" class="text-[10px] uppercase font-bold tracking-widest bg-yellow-100 text-yellow-800 border border-yellow-200 px-2 py-1 rounded hidden"></div>
    </div>
    <p class="text-[11px] font-medium text-soft-slate mb-5 leading-relaxed bg-white border border-border-soft p-3 rounded-lg">
      <strong class="text-ink-navy">AI boundary:</strong> AI helps parse your meal text, but it does not calculate final calories or macros. Foods are matched through USDA-first search where available, and totals are calculated by the deterministic nutrition engine.
    </p>
    
    <div id="parsed-items-list" class="space-y-4 mb-6 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar">
      <!-- Items render here -->
    </div>
    
    <div class="flex justify-end pt-5 border-t border-border-soft">
      <button type="button" id="parser-add-all-btn" class="h-12 px-8 rounded-[var(--radius-button)] bg-usda-emerald text-white text-[15px] font-semibold hover:bg-fresh-leaf transition-colors disabled:opacity-50 shadow-sm hover:shadow-premium interactive-button" disabled>
        Add valid items to meal
      </button>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background-color: var(--color-border-soft); border-radius: 10px; }
</style>

<script>
  const parserForm = document.getElementById('parser-form');
  const mealText = document.getElementById('meal-text') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('parser-submit-btn') as HTMLButtonElement;
  const exampleBtn = document.getElementById('parser-example-btn');
  const clearBtn = document.getElementById('parser-clear-btn');
  const errorEl = document.getElementById('parser-error');
  const reviewArea = document.getElementById('parser-review-area');
  const itemsList = document.getElementById('parsed-items-list');
  const addAllBtn = document.getElementById('parser-add-all-btn') as HTMLButtonElement;
  const providerNotice = document.getElementById('parser-provider-notice');
  
  let currentParsedItems = [];
  
  mealText.addEventListener('input', () => {
    clearBtn.classList.toggle('hidden', mealText.value.trim().length === 0);
  });

  exampleBtn.addEventListener('click', () => {
    mealText.value = "1 cup oats and banana, chickpea salad, and lentil soup";
    clearBtn.classList.remove('hidden');
  });

  clearBtn.addEventListener('click', () => {
    mealText.value = '';
    clearBtn.classList.add('hidden');
    reviewArea.classList.add('hidden');
    errorEl.classList.add('hidden');
    currentParsedItems = [];
  });

  parserForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = mealText.value.trim();
    if (text.length < 2) return;
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Parsing...';
    errorEl.classList.add('hidden');
    reviewArea.classList.add('hidden');
    currentParsedItems = [];
    itemsList.innerHTML = '';
    
    try {
      const res = await fetch('/api/parse-meal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text })
      });
      
      const data = await res.json();
      
      if (!data.ok) {
        throw new Error(data.message || 'Parsing failed.');
      }
      
      currentParsedItems = data.parsed.items.map((item) => ({ ...item, resolvedFood: null, resolving: true, resolutionError: null }));
      
      if (data.provider === 'basic' || data.provider === 'mock') {
        providerNotice.textContent = 'MOCK PARSER';
        providerNotice.classList.remove('hidden');
      } else {
        providerNotice.classList.add('hidden');
      }
      
      reviewArea.classList.remove('hidden');
      renderItems();
      resolveItems();
      
    } catch (err: any) {
      errorEl.textContent = err.message || 'Failed to parse meal.';
      errorEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Parse meal';
    }
  });

  function renderItems() {
    itemsList.innerHTML = currentParsedItems.map((item, idx) => {
      let statusHtml = '';
      if (item.resolving) {
        statusHtml = `<span class="text-[11px] font-bold text-soft-slate uppercase tracking-widest flex items-center gap-1.5"><svg class="animate-spin h-3.5 w-3.5 text-usda-emerald" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Finding match...</span>`;
      } else if (item.resolutionError) {
        statusHtml = `<span class="text-[11px] font-bold uppercase tracking-widest text-red-600">${item.resolutionError}</span>`;
      } else if (item.resolvedFood) {
        const isUsda = item.resolvedFood.source === 'usda';
        const badgeClasses = isUsda ? "bg-mint-wash text-usda-emerald border-emerald-soft" : "bg-slate-50 text-soft-slate border-border-soft";
        statusHtml = `<div class="flex items-center gap-2 mt-1">
          <span class="text-[13px] font-bold text-ink-navy truncate max-w-[200px]" title="${item.resolvedFood.displayName}">${item.resolvedFood.displayName}</span>
          <span class="text-[10px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded border ${badgeClasses}">${item.resolvedFood.sourceLabel || (isUsda ? 'USDA' : 'Local')}</span>
        </div>`;
      }
      
      const warningsHtml = (item.warnings.length > 0 || item.needsReview) 
        ? `<div class="mt-3 text-[11px] font-medium text-amber-800 bg-amber-50 px-3 py-2 rounded border border-amber-200">${item.warnings.join(' ')} ${item.needsReview ? 'Please review quantity/unit.' : ''}</div>` 
        : '';
        
      return `
      <div class="bg-white border border-border-soft rounded-[var(--radius-button)] p-5 relative shadow-sm transition-all hover:shadow-md" data-idx="${idx}">
        <button type="button" class="remove-item-btn absolute top-2 right-2 w-8 h-8 flex items-center justify-center rounded-full text-soft-slate hover:text-red-600 hover:bg-red-50 transition-colors tap-target" aria-label="Remove parsed item: ${item.foodName}">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        
        <div class="mb-4 pr-8">
          <span class="text-[10px] uppercase font-bold text-usda-emerald tracking-widest">Parsed:</span>
          <span class="text-[15px] font-medium text-ink-navy ml-1.5">${item.rawText}</span>
        </div>
        
        <div class="grid grid-cols-12 gap-3 items-end mb-4">
          <div class="col-span-12 sm:col-span-6">
            <label class="block text-[10px] font-bold text-ink-navy uppercase tracking-widest mb-1.5">Search Query</label>
            <input type="text" aria-label="Search Query" class="edit-query w-full h-10 px-3 text-[13px] font-medium rounded bg-white border border-border-soft text-ink-navy focus:outline-none focus:border-usda-emerald focus:ring-1 focus:ring-usda-emerald transition-colors" value="${item.usdaSearchQuery || item.foodName}">
          </div>
          <div class="col-span-6 sm:col-span-3">
            <label class="block text-[10px] font-bold text-ink-navy uppercase tracking-widest mb-1.5">Qty</label>
            <input type="number" aria-label="Quantity" min="0" step="any" class="edit-qty w-full h-10 px-3 text-[13px] font-medium rounded bg-white border border-border-soft text-ink-navy focus:outline-none focus:border-usda-emerald focus:ring-1 focus:ring-usda-emerald transition-colors" value="${item.quantity || ''}">
          </div>
          <div class="col-span-6 sm:col-span-3">
            <label class="block text-[10px] font-bold text-ink-navy uppercase tracking-widest mb-1.5">Unit</label>
            <input type="text" aria-label="Unit" class="edit-unit w-full h-10 px-3 text-[13px] font-medium rounded bg-white border border-border-soft text-ink-navy focus:outline-none focus:border-usda-emerald focus:ring-1 focus:ring-usda-emerald transition-colors" value="${item.unit || ''}">
          </div>
        </div>
        
        <div class="flex items-center justify-between mt-2 bg-slate-50 -mx-5 -mb-5 px-5 py-3.5 rounded-b-[var(--radius-button)] border-t border-border-soft">
          <div class="flex-1">
            ${statusHtml}
          </div>
          <button type="button" class="resolve-btn text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 bg-white border border-border-soft rounded text-ink-navy hover:bg-slate-100 hover:border-soft-slate transition-colors ml-3 shrink-0 disabled:opacity-50 shadow-sm">
            Find Match
          </button>
        </div>
        
        ${warningsHtml ? `<div class="mt-5">${warningsHtml}</div>` : ''}
      </div>
      `;
    }).join('');
    
    document.querySelectorAll('#parsed-items-list .remove-item-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const el = (e.target as Element).closest('[data-idx]');
        if(!el) return;
        const idx = parseInt(el.getAttribute('data-idx') || '0');
        currentParsedItems.splice(idx, 1);
        renderItems();
        checkReadyToAdd();
      });
    });
    
    document.querySelectorAll('#parsed-items-list .resolve-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const card = (e.target as Element).closest('[data-idx]');
        if(!card) return;
        const idx = parseInt(card.getAttribute('data-idx') || '0');
        const query = (card.querySelector('.edit-query') as HTMLInputElement).value.trim();
        const qty = parseFloat((card.querySelector('.edit-qty') as HTMLInputElement).value);
        const unit = (card.querySelector('.edit-unit') as HTMLInputElement).value.trim();
        
        currentParsedItems[idx].usdaSearchQuery = query;
        currentParsedItems[idx].quantity = qty;
        currentParsedItems[idx].unit = unit;
        
        resolveSingleItem(idx);
      });
    });
    
    document.querySelectorAll('#parsed-items-list input').forEach(input => {
      input.addEventListener('change', (e) => {
        const card = (e.target as Element).closest('[data-idx]');
        if(!card) return;
        const idx = parseInt(card.getAttribute('data-idx') || '0');
        if ((e.target as Element).classList.contains('edit-qty')) {
          currentParsedItems[idx].quantity = parseFloat((e.target as HTMLInputElement).value) || null;
        } else if ((e.target as Element).classList.contains('edit-unit')) {
          currentParsedItems[idx].unit = (e.target as HTMLInputElement).value.trim();
        }
        checkReadyToAdd();
      });
    });
    
    checkReadyToAdd();
  }

  async function resolveSingleItem(idx: number) {
    const item = currentParsedItems[idx];
    item.resolving = true;
    item.resolutionError = null;
    item.resolvedFood = null;
    renderItems();
    
    try {
      const q = encodeURIComponent(item.usdaSearchQuery || item.foodName);
      const searchRes = await fetch(`/api/foods/search?q=${q}`);
      const searchData = await searchRes.json();
      
      if (searchData.results && searchData.results.length > 0) {
        const topResult = searchData.results[0];
        let url = `/api/foods/details?`;
        if (topResult.source === 'usda' && topResult.fdcId && topResult.fdcId !== '0') {
          url += `fdcId=${topResult.fdcId}`;
        } else {
          url += `id=${encodeURIComponent(topResult.id)}&source=local`;
        }
        
        const detailsRes = await fetch(url);
        const detailsData = await detailsRes.json();
        
        if (detailsData.ok && detailsData.food) {
          item.resolvedFood = detailsData.food;
          item.needsReview = false; 
        } else {
          item.resolutionError = "Could not find details";
        }
      } else {
        item.resolutionError = "No match found";
      }
    } catch (err) {
      item.resolutionError = "Network error";
    } finally {
      item.resolving = false;
      renderItems();
      checkReadyToAdd();
    }
  }

  async function resolveItems() {
    const queue = currentParsedItems.map((_, idx) => idx);
    const inFlight = new Set();
    
    while(queue.length > 0 || inFlight.size > 0) {
      while(inFlight.size < 3 && queue.length > 0) {
        const idx = queue.shift();
        if(idx !== undefined) {
          const p = resolveSingleItem(idx).finally(() => inFlight.delete(p));
          inFlight.add(p);
        }
      }
      if (inFlight.size > 0) {
        await Promise.race(inFlight);
      }
    }
  }

  function checkReadyToAdd() {
    const hasReady = currentParsedItems.some(i => i.resolvedFood && i.quantity > 0 && i.unit);
    addAllBtn.disabled = !hasReady;
  }

  addAllBtn.addEventListener('click', () => {
    const validItems: any[] = [];
    currentParsedItems.forEach((item, idx) => {
      if (item.resolvedFood && item.quantity > 0 && item.unit) {
        validItems.push({
          food: item.resolvedFood,
          quantity: item.quantity,
          unit: item.unit,
          idx: idx
        });
      }
    });
    
    if (validItems.length > 0) {
      const event = new CustomEvent('add-parsed-items', { detail: { items: validItems } });
      window.dispatchEvent(event);
      
      const indicesToRemove = validItems.map(v => v.idx).sort((a,b) => b - a);
      indicesToRemove.forEach(idx => currentParsedItems.splice(idx, 1));
      
      renderItems();
      
      if (currentParsedItems.length === 0) {
        reviewArea.classList.add('hidden');
        mealText.value = '';
        clearBtn.classList.add('hidden');
      }
    }
  });
</script>
