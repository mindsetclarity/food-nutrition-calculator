---
import { Icon } from 'astro-icon/components';
import SourceBadge from '../ui/SourceBadge.astro';
---
<section id="calculator" class="py-12 bg-warm-ivory relative z-10 min-h-screen">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    
    <!-- Step Indicator -->
    <div class="flex items-center justify-center gap-4 md:gap-8 mb-8 text-[11px] font-bold uppercase tracking-widest text-soft-slate">
      <span class="flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-slate-200 flex items-center justify-center text-ink-navy">1</span> Search</span>
      <span class="w-8 h-px bg-slate-200 hidden sm:block"></span>
      <span class="flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-slate-200 flex items-center justify-center text-ink-navy">2</span> Add amount</span>
      <span class="w-8 h-px bg-slate-200 hidden sm:block"></span>
      <span class="flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-slate-200 flex items-center justify-center text-ink-navy">3</span> Review totals</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Input Section (Left Column) -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="bg-white rounded-[var(--radius-card)] shadow-soft border border-border-soft p-6 md:p-8">

          <form id="calc-form" class="flex flex-col sm:flex-row gap-4">
            <div class="flex-1 relative">
              <label for="food-search" class="block text-[11px] font-bold text-ink-navy uppercase tracking-widest mb-2">Food Item</label>
              <div class="relative">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-soft-slate" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input type="text" id="food-search" placeholder="Search banana, oats, chicken breast, rice..." autocomplete="off"
                  role="combobox" aria-expanded="false" aria-controls="autocomplete-dropdown"
                  aria-autocomplete="list" aria-haspopup="listbox"
                  class="w-full h-14 pl-12 pr-4 rounded-[var(--radius-button)] bg-white border border-border-soft text-ink-navy placeholder-soft-slate focus-premium transition-shadow shadow-sm disabled:opacity-50 text-base"
                />
              </div>
              <div id="autocomplete-dropdown" role="listbox" aria-label="Food search results"
                class="absolute z-50 w-full sm:w-[22rem] mt-2 bg-white border border-border-soft rounded-xl shadow-premium max-h-80 overflow-y-auto hidden">
                <!-- Results go here -->
              </div>
            </div>

            <div class="w-full sm:w-28 relative">
              <label for="quantity" class="block text-[11px] font-bold text-ink-navy uppercase tracking-widest mb-2">Qty</label>
              <input type="number" id="quantity" min="0" step="any"
                class="w-full h-14 px-4 rounded-[var(--radius-button)] bg-white border border-border-soft text-ink-navy focus-premium transition-shadow shadow-sm disabled:opacity-50 text-base font-medium"
                disabled
              />
            </div>

            <div class="w-full sm:w-36 relative">
              <label for="unit" class="block text-[11px] font-bold text-ink-navy uppercase tracking-widest mb-2">Unit</label>
              <select id="unit" class="w-full h-14 px-4 rounded-[var(--radius-button)] bg-white border border-border-soft text-ink-navy focus-premium transition-shadow shadow-sm appearance-none cursor-pointer disabled:opacity-50 text-base font-medium" disabled>
                <option value="">--</option>
              </select>
              <svg class="absolute right-4 top-[38px] w-4 h-4 text-soft-slate pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>

            <div class="w-full sm:w-auto flex items-end">
              <button type="submit" id="add-btn" disabled class="w-full h-14 px-8 rounded-[var(--radius-button)] bg-ink-navy text-white font-medium hover:bg-deep-slate transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed shadow-ink hover:shadow-premium interactive-button text-base">
                Add
              </button>
            </div>
          </form>

          <div id="fallback-notice" class="text-xs font-medium text-amber-800 bg-amber-50 border border-amber-200 mt-4 p-3 rounded-[var(--radius-button)] hidden flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span class="message-text"></span>
          </div>

          <div id="selected-food-info" class="hidden mt-6 p-4 bg-white border border-border-soft rounded-[var(--radius-button)] flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-mint-wash text-usda-emerald flex items-center justify-center font-bold border border-emerald-soft text-lg">✓</div>
              <div>
                <div id="selected-food-name" class="font-bold text-ink-navy text-[15px]"></div>
                <div class="mt-1" id="selected-food-badge-container"></div>
              </div>
            </div>
            <button type="button" id="clear-selection-btn" class="text-xs font-semibold text-soft-slate hover:text-ink-navy px-3 py-1.5 rounded bg-slate-50 hover:bg-slate-100 transition-colors border border-border-soft">Change</button>
          </div>

          <div id="error-msg" class="text-red-700 text-sm mt-4 hidden bg-red-50 p-3 rounded-[var(--radius-button)] border border-red-100"></div>
        </div>

        <!-- Added Items List -->
        <div class="bg-white rounded-[var(--radius-card)] shadow-soft border border-border-soft overflow-hidden">
          <div class="p-4 border-b border-border-soft bg-slate-50 flex items-center justify-between">
            <h3 class="text-sm font-bold text-ink-navy">Selected Foods</h3>
            <button id="clear-all-btn" class="text-[11px] text-red-600 hover:text-red-700 hidden transition-colors font-bold uppercase tracking-wider bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded border border-red-100">Clear All</button>
          </div>
          <div class="responsive-table-wrap">
            <table class="w-full text-left border-collapse min-w-[500px]">
              <tbody id="meal-list" class="divide-y divide-border-soft text-[15px]">
                <tr id="empty-state">
                  <td colspan="4" class="px-6 py-12 text-center text-soft-slate">
                    <p class="font-bold text-ink-navy text-base mb-1">Start by adding one food.</p>
                    <p class="text-sm mb-6 max-w-sm mx-auto">Search for a food above, choose the amount, and your totals will appear here.</p>
                    <div class="flex flex-wrap justify-center gap-2 max-w-md">
                      <span class="inline-block px-3 py-1 bg-slate-50 border border-border-soft rounded-full text-xs font-medium text-ink-navy">banana</span>
                      <span class="inline-block px-3 py-1 bg-slate-50 border border-border-soft rounded-full text-xs font-medium text-ink-navy">oatmeal</span>
                      <span class="inline-block px-3 py-1 bg-slate-50 border border-border-soft rounded-full text-xs font-medium text-ink-navy">Greek yogurt</span>
                      <span class="inline-block px-3 py-1 bg-slate-50 border border-border-soft rounded-full text-xs font-medium text-ink-navy">brown rice</span>
                      <span class="inline-block px-3 py-1 bg-slate-50 border border-border-soft rounded-full text-xs font-medium text-ink-navy">apple</span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Results Section -->
      <div class="lg:col-span-5 flex flex-col gap-6 relative">
        <div class="sticky top-28 space-y-6">
          
          <div id="totals-empty-state" class="bg-white rounded-[var(--radius-card)] border border-border-soft shadow-soft p-8 text-center text-soft-slate">
            <svg class="w-12 h-12 mx-auto mb-4 text-slate-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            <p class="font-bold text-ink-navy mb-1">Add a food to see totals.</p>
            <p class="text-sm">Totals will appear here once you select your first item.</p>
          </div>

          <div id="totals-dashboard" class="hidden space-y-6">
            <div class="bg-ink-navy text-white rounded-[var(--radius-card)] p-6 md:p-8 shadow-premium overflow-hidden relative">
              <div class="absolute -right-12 -top-12 w-48 h-48 bg-usda-emerald rounded-full opacity-20 blur-3xl"></div>
              <h3 class="text-white/70 text-[11px] font-bold uppercase tracking-widest mb-2 relative z-10">Total Calories</h3>
              <div class="flex items-baseline gap-2 relative z-10">
                <div class="text-5xl font-black tracking-tighter" id="total-cals">0</div>
                <div class="text-white/60 font-semibold">kcal</div>
              </div>
            </div>

            <div class="bg-white rounded-[var(--radius-card)] border border-border-soft shadow-soft p-6">
              <h3 class="text-ink-navy text-sm font-bold mb-5 tracking-tight flex items-center justify-between">
                Macronutrients
              </h3>
              <div class="space-y-4">
                <div>
                  <div class="flex justify-between items-end mb-1.5">
                    <span class="text-soft-slate font-semibold text-sm">Protein</span>
                    <span class="text-ink-navy font-black"><span id="total-protein">0</span><span class="text-sm text-soft-slate ml-0.5 font-bold">g</span></span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <div class="bg-usda-emerald h-2 rounded-full transition-all duration-700 ease-out" style="width: 0%" id="bar-protein"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between items-end mb-1.5">
                    <span class="text-soft-slate font-semibold text-sm">Carbs</span>
                    <span class="text-ink-navy font-black"><span id="total-carbs">0</span><span class="text-sm text-soft-slate ml-0.5 font-bold">g</span></span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <div class="bg-nutrient-amber h-2 rounded-full transition-all duration-700 ease-out" style="width: 0%" id="bar-carbs"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between items-end mb-1.5">
                    <span class="text-soft-slate font-semibold text-sm">Fat</span>
                    <span class="text-ink-navy font-black"><span id="total-fat">0</span><span class="text-sm text-soft-slate ml-0.5 font-bold">g</span></span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <div class="bg-berry-accent h-2 rounded-full transition-all duration-700 ease-out" style="width: 0%" id="bar-fat"></div>
                  </div>
                </div>
              </div>
            </div>

            <details class="bg-white rounded-[var(--radius-card)] border border-border-soft shadow-soft group">
              <summary class="p-4 font-bold text-sm text-ink-navy cursor-pointer list-none flex items-center justify-between outline-none focus-visible:ring-2 focus-visible:ring-usda-emerald">
                Show detailed nutrients
                <svg class="w-5 h-5 text-soft-slate group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="p-6 border-t border-border-soft">
                <div class="flex justify-between py-2 border-b border-border-soft text-sm">
                  <span class="text-soft-slate font-medium">Fiber</span>
                  <span class="font-bold text-ink-navy"><span id="total-fiber">0</span>g</span>
                </div>
                <div class="flex justify-between py-2 border-b border-border-soft text-sm">
                  <span class="text-soft-slate font-medium">Sugar</span>
                  <span class="font-bold text-ink-navy"><span id="total-sugar">0</span>g</span>
                </div>
                <div class="flex justify-between py-2 text-sm mb-4">
                  <span class="text-soft-slate font-medium">Sodium</span>
                  <span class="font-bold text-ink-navy"><span id="total-sodium">0</span>mg</span>
                </div>
                <p class="text-[11px] text-soft-slate leading-relaxed font-medium bg-slate-50 p-3 rounded">
                  <strong class="text-ink-navy">Note:</strong> USDA data is used when available. Local estimates are clearly labeled.
                </p>
              </div>
            </details>
          </div>
          
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { calculateFoodItem, calculateMealTotals } from '../../lib/nutrition/calculateNutrition';
  import { hasKnownNutrient } from '../../lib/nutrition/nutrientUtils';
  import { escapeHtml as esc } from '../../lib/safety/escapeHtml';

  // State
  let addedItems = [];
  let currentSelectedFood = null;
  let searchDebounceTimeout = null;
  let currentAbortController = null;

  // DOM Elements
  const searchInput = document.getElementById('food-search');
  const dropdown = document.getElementById('autocomplete-dropdown');
  const qtyInput = document.getElementById('quantity');
  const unitSelect = document.getElementById('unit');
  const addBtn = document.getElementById('add-btn');
  const calcForm = document.getElementById('calc-form');
  const errorMsg = document.getElementById('error-msg');
  const fallbackNotice = document.getElementById('fallback-notice');
  const fallbackNoticeText = fallbackNotice.querySelector('.message-text');
  
  const selectedFoodInfo = document.getElementById('selected-food-info');
  const selectedFoodName = document.getElementById('selected-food-name');
  const selectedFoodBadgeContainer = document.getElementById('selected-food-badge-container');
  const clearSelectionBtn = document.getElementById('clear-selection-btn');
  
  const mealList = document.getElementById('meal-list');
  const emptyState = document.getElementById('empty-state');
  const clearAllBtn = document.getElementById('clear-all-btn');
  
  const totalsEmptyState = document.getElementById('totals-empty-state');
  const totalsDashboard = document.getElementById('totals-dashboard');

  function showError(msg) {
    errorMsg.textContent = msg;
    errorMsg.classList.remove('hidden');
    setTimeout(() => errorMsg.classList.add('hidden'), 5000);
  }

  function announce(msg) {
    const el = document.getElementById('a11y-status');
    if (el) el.textContent = msg;
  }

  // --- Combobox state -------------------------------------------------
  // The dropdown is a listbox whose options never take focus: focus stays in
  // the input and aria-activedescendant points at the active option, which is
  // what lets a keyboard reach results at all.
  let activeIndex = -1;

  const getOptions = () => Array.from(dropdown.querySelectorAll('[role="option"]'));

  function setExpanded(open) {
    dropdown.classList.toggle('hidden', !open);
    searchInput.setAttribute('aria-expanded', String(open));
    if (!open) setActiveOption(-1);
  }

  function setActiveOption(index) {
    const options = getOptions();
    if (!options.length) index = -1;
    activeIndex = index;
    options.forEach((opt, i) => {
      const on = i === index;
      opt.setAttribute('aria-selected', String(on));
      opt.classList.toggle('bg-slate-50', on);
    });
    if (index >= 0) {
      searchInput.setAttribute('aria-activedescendant', options[index].id);
      options[index].scrollIntoView({ block: 'nearest' });
    } else {
      searchInput.removeAttribute('aria-activedescendant');
    }
  }

  function moveActive(delta) {
    const options = getOptions();
    if (!options.length) return;
    const next = activeIndex < 0
      ? (delta > 0 ? 0 : options.length - 1)
      : (activeIndex + delta + options.length) % options.length;
    setActiveOption(next);
  }

  searchInput.addEventListener('keydown', (e) => {
    const open = !dropdown.classList.contains('hidden');
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      if (!open) return;
      e.preventDefault();
      moveActive(e.key === 'ArrowDown' ? 1 : -1);
    } else if (e.key === 'Enter') {
      if (open && activeIndex >= 0) {
        // Enter is picking a suggestion here, not submitting the form.
        e.preventDefault();
        chooseResult(getOptions()[activeIndex]);
      }
    } else if (e.key === 'Escape') {
      if (open) {
        e.preventDefault();
        setExpanded(false);
      }
    } else if (e.key === 'Tab') {
      if (open) setExpanded(false);
    }
  });

  dropdown.addEventListener('mousemove', (e) => {
    const opt = e.target.closest('[role="option"]');
    if (opt) setActiveOption(getOptions().indexOf(opt));
  });

  // Handle Search Input
  searchInput.addEventListener('input', (e) => {
    const q = e.target.value.trim();
    if (q.length < 2) {
      setExpanded(false);
      if (currentAbortController) currentAbortController.abort();
      fallbackNotice.classList.add('hidden');
      return;
    }
    
    clearTimeout(searchDebounceTimeout);
    
    dropdown.innerHTML = `<div class="p-6 text-[15px] font-medium text-soft-slate text-center flex items-center justify-center gap-2"><svg class="animate-spin h-5 w-5 text-usda-emerald" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Searching...</div>`;
    setExpanded(true);
    fallbackNotice.classList.add('hidden');

    searchDebounceTimeout = setTimeout(async () => {
      if (currentAbortController) currentAbortController.abort();
      currentAbortController = new AbortController();

      try {
        const res = await fetch(`/api/foods/search?q=${encodeURIComponent(q)}`, { signal: currentAbortController.signal });
        if (!res.ok) throw new Error("Search failed");
        
        const data = await res.json();
        
        if (data.fallbackUsed) {
          fallbackNoticeText.textContent = data.message || "USDA search is unavailable right now. Showing local estimates where available.";
          fallbackNotice.classList.remove('hidden');
        } else {
          fallbackNotice.classList.add('hidden');
        }

        if (data.results && data.results.length > 0) {
          dropdown.innerHTML = data.results.map((f, i) => {
            const isUsda = f.source === 'usda';
            const badgeClasses = isUsda
              ? "bg-mint-wash text-usda-emerald border-emerald-soft"
              : "bg-slate-50 text-soft-slate border-border-soft";
            const meta = `${f.brandName ? f.brandName + ' • ' : ''}${f.dataType || 'Food'}`;
            return `
            <div role="option" id="food-option-${i}" aria-selected="false" class="p-4 cursor-pointer border-b border-border-soft last:border-0 flex justify-between items-center gap-3 transition-colors"
              data-id="${esc(f.id)}" data-fdcid="${esc(f.fdcId)}" data-source="${esc(f.source)}">
              <div class="min-w-0">
                <div class="font-bold text-ink-navy text-[15px]">${esc(f.displayName)}</div>
                <div class="text-[11px] font-medium text-soft-slate mt-1 tracking-wide">${esc(meta)}</div>
              </div>
              <div class="text-[10px] uppercase font-bold tracking-widest px-2 py-1 rounded border shrink-0 whitespace-nowrap ${badgeClasses}">${esc(f.sourceLabel || (isUsda ? 'USDA' : 'Local'))}</div>
            </div>
          `}).join('');
          setActiveOption(-1);
          announce(`${data.results.length} result${data.results.length === 1 ? '' : 's'} available. Use the up and down arrow keys to review, Enter to select.`);
        } else {
          dropdown.innerHTML = `<div class="p-6 text-[15px] font-medium text-soft-slate text-center">No foods found. Try a simpler name like 'banana' or 'rice'.</div>`;
          setActiveOption(-1);
          announce('No foods found.');
        }
        setExpanded(true);
      } catch (err) {
        if (err.name !== 'AbortError') {
          dropdown.innerHTML = `<div class="p-6 text-[15px] font-medium text-red-600 text-center">Search failed. Please try again.</div>`;
        }
      }
    }, 300);
  });

  // Handle Selection
  dropdown.addEventListener('click', (e) => {
    const item = e.target.closest('[data-id]');
    if (item) chooseResult(item);
  });

  async function chooseResult(item) {
    if (!item) return;

    const id = item.getAttribute('data-id');
    const fdcId = item.getAttribute('data-fdcid');
    const source = item.getAttribute('data-source');

    setExpanded(false);
    searchInput.disabled = true;
    searchInput.value = 'Loading details...';
    fallbackNotice.classList.add('hidden');
    
    try {
      let url = `/api/foods/details?`;
      if (source === 'usda' && fdcId && fdcId !== '0') {
        url += `fdcId=${fdcId}`;
      } else {
        url += `id=${encodeURIComponent(id)}&source=local`;
      }
      
      const res = await fetch(url);
      if (!res.ok) throw new Error("Failed to load details");
      const data = await res.json();
      
      if (data.ok && data.food) {
        selectFood(data.food);
      } else {
        throw new Error(data.message || "Invalid food data");
      }
    } catch (err) {
      showError("Food details could not be loaded. Try another result.");
      searchInput.disabled = false;
      searchInput.value = '';
      searchInput.focus();
    }
  }

  // Hide dropdown on click outside
  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
      setExpanded(false);
    }
  });

  function selectFood(food) {
    currentSelectedFood = food;
    
    // Update UI
    searchInput.classList.add('hidden');
    searchInput.disabled = false;
    searchInput.value = '';
    
    selectedFoodInfo.classList.remove('hidden');
    selectedFoodName.textContent = food.displayName;
    
    const isUsda = food.source === 'usda';
    const badgeClasses = isUsda 
      ? "bg-mint-wash text-usda-emerald border-emerald-soft" 
      : "bg-slate-50 text-soft-slate border-border-soft";
    
    selectedFoodBadgeContainer.innerHTML = `<span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded border ${badgeClasses} inline-block">${food.sourceLabel || (isUsda ? 'USDA' : 'Local')}</span>`;
    
    // Enable and populate quantity & unit
    qtyInput.disabled = false;
    unitSelect.disabled = false;
    addBtn.disabled = false;
    
    qtyInput.value = food.defaultQuantity || 1;
    
    // Populate units
    let options = '<option value="g">g</option><option value="oz">oz</option><option value="lb">lb</option>';
    if (food.servingSizes) {
      food.servingSizes.forEach(serving => {
        options += `<option value="${serving.unit}">${serving.unit}</option>`;
      });
    }
    unitSelect.innerHTML = options;
    
    if (food.defaultUnit) {
      const optionExists = Array.from(unitSelect.options).some(opt => opt.value === food.defaultUnit);
      if (optionExists) {
        unitSelect.value = food.defaultUnit;
      }
    }
  }

  function clearSelection() {
    currentSelectedFood = null;
    searchInput.value = '';
    searchInput.classList.remove('hidden');
    selectedFoodInfo.classList.add('hidden');
    
    qtyInput.value = '';
    qtyInput.disabled = true;
    unitSelect.innerHTML = '<option value="">--</option>';
    unitSelect.disabled = true;
    addBtn.disabled = true;
    
    searchInput.focus();
  }

  clearSelectionBtn.addEventListener('click', clearSelection);

  // Add item
  calcForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!currentSelectedFood) return;
    
    const qty = parseFloat(qtyInput.value);
    const unit = unitSelect.value;
    
    if (isNaN(qty) || qty <= 0) {
      showError('Enter a quantity greater than zero.');
      return;
    }
    if (!unit) {
      showError('Please select a valid unit.');
      return;
    }

    const input = {
      food: currentSelectedFood,
      quantity: qty,
      unit: unit
    };
    
    const calculatedItem = calculateFoodItem(input);
    
    if (!calculatedItem.validation.isValid) {
      showError(calculatedItem.validation.error || 'This unit is not available for the selected food.');
      return;
    }

    addedItems.push(calculatedItem);
    clearSelection();
    updateMealUI();
    const el = document.getElementById('a11y-status');
    if (el) el.textContent = `${calculatedItem.displayName} added to meal.`;
  });



  window.removeMealItem = function(id) {
    addedItems = addedItems.filter(item => item.id !== id);
    updateMealUI();
    const el = document.getElementById('a11y-status');
    if (el) el.textContent = 'Item removed from meal';
  };

  clearAllBtn.addEventListener('click', () => {
    addedItems = [];
    updateMealUI();
    const el = document.getElementById('a11y-status');
    if (el) el.textContent = 'All items cleared from meal';
  });

  function updateMealUI() {
    const mealTotals = calculateMealTotals(addedItems);
    
    if (addedItems.length === 0) {
      mealList.innerHTML = '';
      mealList.appendChild(emptyState);
      clearAllBtn.classList.add('hidden');
      
      totalsEmptyState.classList.remove('hidden');
      totalsDashboard.classList.add('hidden');
    } else {
      if (mealList.contains(emptyState)) mealList.removeChild(emptyState);
      
      totalsEmptyState.classList.add('hidden');
      totalsDashboard.classList.remove('hidden');
      
      mealList.innerHTML = addedItems.map(item => {
        const isUsda = item.source === 'usda';
        const badgeClasses = isUsda 
          ? "bg-mint-wash text-usda-emerald border-emerald-soft" 
          : "bg-slate-50 text-soft-slate border-border-soft";

        return `
        <tr class="hover:bg-slate-50 transition-colors group">
          <td class="px-6 md:px-8 py-5">
            <div class="font-bold text-ink-navy text-[15px] leading-snug pr-4">${item.displayName}</div>
            <div class="mt-1.5">
              <span class="inline-block text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded border ${badgeClasses}">
                ${item.sourceLabel || (isUsda ? 'USDA' : 'Local')}
              </span>
            </div>
          </td>
          <td class="px-6 md:px-8 py-5 text-right whitespace-nowrap">
            <div class="font-bold text-ink-navy text-[15px]">${item.quantity} ${item.unit}</div>
            <div class="text-[11px] font-semibold text-soft-slate mt-1 uppercase tracking-wider">${Math.round(item.grams)}g</div>
          </td>
          <td class="px-6 md:px-8 py-5 text-right">
            <div class="font-black text-ink-navy text-lg">${item.nutrients.calories !== null ? Math.round(item.nutrients.calories) : '<span aria-hidden="true">&mdash;</span><span class="sr-only">No data</span>'}</div>
            <div class="text-[10px] font-bold text-soft-slate uppercase tracking-widest mt-0.5">kcal</div>
          </td>
          <td class="px-6 py-5 text-center">
            <button onclick="removeMealItem('${item.id}')" class="w-8 h-8 rounded-full flex items-center justify-center text-soft-slate hover:text-red-600 hover:bg-red-50 transition-colors tap-target opacity-50 group-hover:opacity-100" title="Remove ${item.displayName}" aria-label="Remove ${item.displayName}">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </td>
        </tr>
      `}).join('');
      
      clearAllBtn.classList.remove('hidden');
    }

    const n = mealTotals.nutrients;
    const formatN = (val) => val !== null && val !== undefined ? Number(val).toFixed(1) : 'N/A';
    const formatInt = (val) => val !== null && val !== undefined ? Math.round(val) : 'N/A';

    document.getElementById('total-cals').textContent = formatInt(mealTotals.calories);
    document.getElementById('total-protein').textContent = formatN(n.protein);
    document.getElementById('total-carbs').textContent = formatN(n.carbohydrates);
    document.getElementById('total-fat').textContent = formatN(n.fat);
    document.getElementById('total-fiber').textContent = formatN(n.fiber);
    document.getElementById('total-sugar').textContent = formatN(n.sugar);
    document.getElementById('total-sodium').textContent = formatInt(n.sodium);

    const p = hasKnownNutrient(n.protein) ? n.protein : 0;
    const c = hasKnownNutrient(n.carbohydrates) ? n.carbohydrates : 0;
    const f = hasKnownNutrient(n.fat) ? n.fat : 0;
    const totalMacro = p + c + f || 1;
    
    document.getElementById('bar-protein').style.width = `${(p / totalMacro) * 100}%`;
    document.getElementById('bar-carbs').style.width = `${(c / totalMacro) * 100}%`;
    document.getElementById('bar-fat').style.width = `${(f / totalMacro) * 100}%`;
  }
</script>
