---
// Page shell for single-calculator pages: header, the tool, a safety note, the
// explanation (default slot) and an FAQ with schema.
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../site/PageHeader.astro';
import FaqList from '../seo/FaqList.astro';
import { buildFAQPageSchema, buildWebPageSchema } from '../../lib/seo/schema';
import { siteConfig } from '../../lib/seo/siteConfig';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
  path: string;
  safety: string;
  faqs: { question: string; answer: string }[];
}
const { title, description, heading, intro, path, safety, faqs } = Astro.props;
const jsonLd = [buildWebPageSchema({ name: title, description, url: `${siteConfig.siteUrl}${path}` }), buildFAQPageSchema(faqs)];
---
<SiteLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHeader title={heading} description={intro} breadcrumbs={[{ label: heading }]} chipType="calculator" />
  <div class="bg-warm-ivory pb-24 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
      <slot name="tool" />
      <p class="text-sm text-gray-600">Your answers stay in your browser and are not sent or saved. {safety}</p>
      <section class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-4 text-gray-700 leading-relaxed">
        <slot />
      </section>
      <FaqList faqs={faqs} heading={`${heading} FAQ`} />
    </div>
  </div>
</SiteLayout>
