---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import SourceBadge from '../ui/SourceBadge.astro';
---

<section class="pb-24 bg-background relative z-20 -mt-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative animate-fade-up" style="animation-delay: 200ms;">
      <!-- Glow effect behind the card -->
      <div class="absolute -inset-1 bg-gradient-to-r from-brand-400 to-accent opacity-20 blur-xl rounded-[2rem] -z-10"></div>
      
      <!-- Premium Glass Card -->
      <div class="bg-surface/90 backdrop-blur-xl border border-white/40 shadow-premium rounded-2xl overflow-hidden">
        
        <!-- Mock App Header -->
        <div class="flex items-center px-6 py-4 border-b border-border bg-slate-50/50">
          <div class="flex gap-2 mr-4">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 bg-surface border border-border rounded-md px-3 py-1.5 flex items-center shadow-sm">
            <svg class="w-4 h-4 text-muted mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span class="text-muted text-sm font-mono opacity-70">Greek yogurt, chicken breast, oatmeal...</span>
          </div>
        </div>
        
        <!-- Mock App Body -->
        <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Mock Added Foods List -->
          <div class="md:col-span-2 space-y-4">
            <h3 class="text-sm font-semibold text-foreground uppercase tracking-wider mb-4">Added Foods</h3>
            
            <!-- Item 1 -->
            <div class="flex items-center justify-between p-4 bg-surface border border-border rounded-xl shadow-sm hover:border-brand-300 transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                </div>
                <div>
                  <div class="font-medium text-foreground">Greek Yogurt, Plain, Nonfat</div>
                  <div class="text-sm text-muted">1 cup (245g)</div>
                </div>
              </div>
              <div class="text-right">
                <div class="font-bold text-foreground">145 kcal</div>
                <SourceBadge source="USDA" class="mt-1" />
              </div>
            </div>

            <!-- Item 2 -->
            <div class="flex items-center justify-between p-4 bg-surface border border-border rounded-xl shadow-sm hover:border-brand-300 transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                </div>
                <div>
                  <div class="font-medium text-foreground">Blueberries, Raw</div>
                  <div class="text-sm text-muted">0.5 cup (74g)</div>
                </div>
              </div>
              <div class="text-right">
                <div class="font-bold text-foreground">42 kcal</div>
                <SourceBadge source="USDA" class="mt-1" />
              </div>
            </div>
            
            <!-- Item 3 -->
            <div class="flex items-center justify-between p-4 bg-surface border border-border rounded-xl shadow-sm hover:border-brand-300 transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                </div>
                <div>
                  <div class="font-medium text-foreground">Oatmeal, Cooked</div>
                  <div class="text-sm text-muted">1 cup (234g)</div>
                </div>
              </div>
              <div class="text-right">
                <div class="font-bold text-foreground">158 kcal</div>
                <SourceBadge source="USDA" class="mt-1" />
              </div>
            </div>

          </div>
          
          <!-- Mock Nutrition Summary -->
          <div class="bg-slate-50 rounded-xl p-6 border border-border flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-semibold text-foreground uppercase tracking-wider mb-6">Nutrition Summary</h3>
              
              <div class="text-center mb-8">
                <div class="text-5xl font-extrabold text-slate-900 mb-1">345</div>
                <div class="text-sm text-muted font-medium uppercase tracking-widest">Total Calories</div>
              </div>
              
              <div class="space-y-4">
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="font-medium text-foreground">Protein</span>
                    <span class="font-bold text-slate-900">30g</span>
                  </div>
                  <div class="w-full bg-border rounded-full h-2">
                    <div class="bg-brand-500 h-2 rounded-full" style="width: 60%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="font-medium text-foreground">Carbs</span>
                    <span class="font-bold text-slate-900">48g</span>
                  </div>
                  <div class="w-full bg-border rounded-full h-2">
                    <div class="bg-blue-500 h-2 rounded-full" style="width: 45%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="font-medium text-foreground">Fat</span>
                    <span class="font-bold text-slate-900">4.5g</span>
                  </div>
                  <div class="w-full bg-border rounded-full h-2">
                    <div class="bg-amber-500 h-2 rounded-full" style="width: 15%"></div>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="mt-8 pt-4 border-t border-border text-center">
              <span class="text-xs text-muted font-mono bg-surface px-2 py-1 border border-border rounded shadow-sm">Demo preview — full calculator built in upcoming phases.</span>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>
</section>
