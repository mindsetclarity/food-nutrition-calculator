---
import { buildFAQPageSchema } from '../../lib/seo/schema';

const faqs = [
  {
    question: "What is a food nutrition calculator?",
    answer: "A food nutrition calculator is a tool designed to help you track calories, macronutrients (protein, carbs, fat), and detailed nutrition facts for the foods you eat. It allows you to search for ingredients, set precise serving sizes, and instantly see a comprehensive breakdown of your dietary intake."
  },
  {
    question: "How accurate are the nutrition values?",
    answer: "The values provided are carefully calculated estimates. We prioritize data from the USDA FoodData Central database where available, which is considered the gold standard for nutritional accuracy in the US. Keep in mind that natural variations in food and different preparation methods mean all nutrition facts should be treated as high-quality estimates rather than absolute certainties."
  },
  {
    question: "Can I calculate full meals?",
    answer: "Yes. Our platform is designed not just for individual food lookups, but to seamlessly calculate full meals and multi-ingredient recipes. You can add multiple items together to see the combined nutritional profile for your entire plate."
  },
  {
    question: "Does this use USDA data?",
    answer: "Yes, our architecture is built around a USDA-first data strategy. We use USDA FoodData Central as our primary source of truth. When USDA data isn't available for specific branded or niche items, we use high-quality local fallbacks, and we always show clear source badges so you know exactly where your data comes from."
  },
  {
    question: "Do I need an account to use the calculator?",
    answer: "No. You can use the core calculation features immediately without creating an account or logging in. We believe essential nutrition tools should be frictionless and accessible to everyone."
  }
];

const jsonLd = buildFAQPageSchema(faqs);
---

<section class="py-24 bg-surface border-t border-border">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <h2 class="text-3xl font-extrabold tracking-tight mb-4 text-foreground">
        Frequently asked questions
      </h2>
      <p class="text-lg text-muted">
        Everything you need to know about calculating food nutrition.
      </p>
    </div>

    <div class="space-y-6 animate-fade-up" style="animation-delay: 200ms;">
      {faqs.map((faq) => (
        <div class="bg-background rounded-xl p-6 border border-border shadow-sm">
          <h3 class="text-lg font-bold text-foreground mb-2">{faq.question}</h3>
          <p class="text-muted leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
