---
---

<section class="py-24 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <h2 class="text-3xl md:text-4xl font-extrabold text-foreground tracking-tight mb-4">How it works</h2>
      <p class="text-lg text-muted max-w-2xl mx-auto">
        Four simple steps to get accurate nutrition data for any meal. USDA data is used first where available, with local data supporting fast fallback.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Step 1 -->
      <div class="relative group">
        <div class="hidden md:block absolute top-6 left-[60%] w-[80%] h-0.5 bg-border -z-10 group-hover:bg-brand-200 transition-colors"></div>
        <div class="flex flex-col items-center text-center">
          <div class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center text-xl font-bold mb-6 shadow-sm group-hover:scale-110 transition-transform">
            1
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3">Search</h3>
          <p class="text-muted leading-relaxed text-sm">
            Search or describe your food using our smart search bar.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative group">
        <div class="hidden md:block absolute top-6 left-[60%] w-[80%] h-0.5 bg-border -z-10 group-hover:bg-brand-200 transition-colors"></div>
        <div class="flex flex-col items-center text-center">
          <div class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center text-xl font-bold mb-6 shadow-sm group-hover:scale-110 transition-transform">
            2
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3">Quantity</h3>
          <p class="text-muted leading-relaxed text-sm">
            Choose your quantity and standard US unit (cups, oz, tbsp).
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative group">
        <div class="hidden md:block absolute top-6 left-[60%] w-[80%] h-0.5 bg-border -z-10 group-hover:bg-brand-200 transition-colors"></div>
        <div class="flex flex-col items-center text-center">
          <div class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center text-xl font-bold mb-6 shadow-sm group-hover:scale-110 transition-transform">
            3
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3">Review</h3>
          <p class="text-muted leading-relaxed text-sm">
            Review the source badge to ensure data matches your expectations.
          </p>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="relative group">
        <div class="flex flex-col items-center text-center">
          <div class="w-12 h-12 rounded-full bg-brand-500 text-white flex items-center justify-center text-xl font-bold mb-6 shadow-premium group-hover:scale-110 transition-transform">
            4
          </div>
          <h3 class="text-xl font-bold text-foreground mb-3">Results</h3>
          <p class="text-muted leading-relaxed text-sm">
            See complete calories, macros, and nutrition totals instantly.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
