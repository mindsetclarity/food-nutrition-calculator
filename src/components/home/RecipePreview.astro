---
---

<section class="py-24 bg-surface relative overflow-hidden">
  <!-- Soft background gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-brand-50/50 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Text Content -->
      <div class="animate-fade-up">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-6 text-foreground">
          Analyze complete recipes instantly
        </h2>
        <p class="text-lg text-muted leading-relaxed mb-8">
          Stop calculating each ingredient one by one. Our upcoming Recipe Nutrition Calculator lets you paste your entire ingredients list, set your serving size, and see the exact nutrition profile per serving.
        </p>
        
        <a href="/recipe-nutrition-calculator" class="inline-flex justify-center items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-slate-900 hover:bg-slate-800 shadow-sm focus-ring transition-all hover-lift">
          Try Recipe Analyzer Preview
          <svg class="ml-2 -mr-1 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Visual Content (Static Mock) -->
      <div class="animate-fade-up" style="animation-delay: 200ms;">
        <div class="bg-white rounded-2xl border border-border shadow-premium overflow-hidden">
          
          <!-- Mock Header -->
          <div class="bg-slate-50 border-b border-border px-6 py-4 flex justify-between items-center">
            <h3 class="font-bold text-foreground">Protein Oatmeal Recipe</h3>
            <div class="text-sm font-medium bg-white border border-border px-3 py-1 rounded-md text-slate-700 shadow-sm">
              Servings: 2
            </div>
          </div>

          <!-- Mock Body -->
          <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Ingredients Input Mock -->
            <div>
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Ingredients</div>
              <div class="bg-slate-50 rounded-lg p-4 font-mono text-sm text-slate-700 border border-border h-48 whitespace-pre-line shadow-inner">
2 eggs
1 cup oats
1 banana
1 tbsp peanut butter
              </div>
            </div>

            <!-- Nutrition Output Mock -->
            <div class="flex flex-col justify-between">
              <div>
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4">Per Serving (1/2 recipe)</div>
                
                <div class="space-y-3">
                  <div class="flex justify-between items-center pb-2 border-b border-border">
                    <span class="font-bold text-foreground">Calories</span>
                    <span class="font-bold text-slate-900">315</span>
                  </div>
                  <div class="flex justify-between items-center pb-2 border-b border-border">
                    <span class="font-medium text-foreground">Protein</span>
                    <span class="font-medium text-slate-700">14.5g</span>
                  </div>
                  <div class="flex justify-between items-center pb-2 border-b border-border">
                    <span class="font-medium text-foreground">Carbs</span>
                    <span class="font-medium text-slate-700">42g</span>
                  </div>
                  <div class="flex justify-between items-center pb-2 border-b border-border">
                    <span class="font-medium text-foreground">Fat</span>
                    <span class="font-medium text-slate-700">11g</span>
                  </div>
                </div>
              </div>

              <div class="mt-4 flex items-center justify-center">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-50 text-brand-700 border border-brand-200">
                  <svg class="mr-1 h-3 w-3 text-brand-500" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg>
                  Parsed successfully
                </span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
