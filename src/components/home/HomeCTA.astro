---
import Button from '../ui/Button.astro';
import FoodChip from '../ui/FoodChip.astro';
---

<section class="py-32 bg-ink-navy relative overflow-hidden text-center border-t border-deep-slate">
  <!-- Subtle Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(var(--color-usda-emerald)_1px,transparent_1px)] [background-size:40px_40px] opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-usda-emerald rounded-full blur-[150px] opacity-20 pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 reveal-hidden" data-reveal>
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6">
      Start with one food.
    </h2>
    <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
      Search a food, build a meal, or paste a recipe. Every result stays source-labeled and reviewable.
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
      <Button href="/calculator" variant="primary" size="lg" class="bg-usda-emerald hover:bg-fresh-leaf text-white shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] border-transparent">
        Start Calculating
      </Button>
      <Button href="/recipe-nutrition-calculator" variant="secondary" size="lg" class="bg-deep-slate text-white border-slate-600 hover:bg-slate-700 hover:border-slate-500 hover:text-white">
        Analyze a Recipe
      </Button>
      <Button href="/foods" variant="secondary" size="lg" class="bg-transparent text-slate-300 border-transparent hover:bg-white/5 hover:text-white shadow-none">
        Browse Foods
      </Button>
    </div>

    <!-- Floating Veg Chips around CTA -->
    <div class="relative w-full h-12 max-w-lg mx-auto pointer-events-none hidden sm:block">
      <div class="absolute -left-12 -top-24 transform -rotate-12 opacity-80">
        <FoodChip icon="🥑" label="avocado" class="bg-white text-ink-navy" />
      </div>
      <div class="absolute left-1/4 10 transform rotate-6 opacity-80">
        <FoodChip icon="🌾" label="oats" class="bg-white text-ink-navy" />
      </div>
      <div class="absolute right-1/4 -top-16 transform -rotate-6 opacity-80">
        <FoodChip icon="🍌" label="banana" class="bg-white text-ink-navy" />
      </div>
      <div class="absolute -right-8 4 transform rotate-12 opacity-80">
        <FoodChip icon="🥣" label="yogurt" class="bg-white text-ink-navy" />
      </div>
    </div>
  </div>
</section>
