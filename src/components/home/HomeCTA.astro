---
import FoodChip from '../ui/FoodChip.astro';
---

<section class="final-cta py-32 bg-ink-navy border-t border-deep-slate">
  <!-- Subtle Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(var(--color-usda-emerald)_1px,transparent_1px)] [background-size:40px_40px] opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-usda-emerald rounded-full blur-[150px] opacity-20 pointer-events-none"></div>

  <!-- Decorative Chips safely placed under content via z-index -->
  <div class="final-cta__decor hidden sm:block">
    <div class="final-cta-chip final-cta-chip--avocado">
      <FoodChip icon="🥑" label="avocado" class="bg-white text-ink-navy shadow-sm" />
    </div>
    <div class="final-cta-chip final-cta-chip--oats">
      <FoodChip icon="🌾" label="oats" class="bg-white text-ink-navy shadow-sm" />
    </div>
    <div class="final-cta-chip final-cta-chip--banana">
      <FoodChip icon="🍌" label="banana" class="bg-white text-ink-navy shadow-sm" />
    </div>
    <div class="final-cta-chip final-cta-chip--yogurt">
      <FoodChip icon="🥣" label="yogurt" class="bg-white text-ink-navy shadow-sm" />
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 final-cta__content" data-reveal>
    <div class="text-center relative z-10">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6">
        Start with one food.
      </h2>
      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        Search a food, build a meal, or paste a recipe. Every result stays source-labeled and reviewable.
      </p>
    </div>
    
    <div class="final-cta__actions">
      <a href="/calculator" class="final-cta__button btn-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink-navy">
        Start Calculating
      </a>
      <a href="/recipe-nutrition-calculator" class="final-cta__button btn-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink-navy">
        Analyze a Recipe
      </a>
      <a href="/foods" class="final-cta__button btn-tertiary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink-navy">
        Browse Foods
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    overflow: hidden;
  }

  .final-cta__content {
    position: relative;
    z-index: 2;
  }

  .final-cta__actions {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    flex-wrap: wrap;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .final-cta__button {
    min-height: 3.5rem;
    min-width: 13rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
    border-radius: 1rem;
    font-weight: 800;
    text-decoration: none;
    line-height: 1;
    transition: all 0.2s ease;
  }

  /* Primary */
  .btn-primary {
    background-color: #10b981; /* usda-emerald */
    color: #ffffff;
    box-shadow: 0 0 20px rgba(16,185,129,0.3);
    border: 1px solid transparent;
  }
  .btn-primary:hover, .btn-primary:active {
    background-color: #059669;
    box-shadow: 0 0 30px rgba(16,185,129,0.5);
    transform: translateY(-1px);
    color: #ffffff;
  }

  /* Secondary */
  .btn-secondary {
    background-color: #ffffff; /* warm ivory/white */
    color: #0f172a; /* deep navy */
    border: 1px solid #e2e8f0;
  }
  .btn-secondary:hover, .btn-secondary:active {
    background-color: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
    transform: translateY(-1px);
  }

  /* Tertiary */
  .btn-tertiary {
    background-color: transparent;
    color: #f8fafc; /* light text */
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .btn-tertiary:hover, .btn-tertiary:active {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Decorative Chips */
  .final-cta__decor {
    position: absolute;
    inset: 0;
    z-index: 1; /* Below content (2) and actions (3) */
    pointer-events: none;
  }

  .final-cta-chip {
    position: absolute;
    opacity: 0.8;
  }

  /* Placement to avoid center column */
  .final-cta-chip--avocado {
    left: 8%;
    top: 56%;
    transform: rotate(-12deg);
  }

  .final-cta-chip--banana {
    right: 12%;
    top: 22%;
    transform: rotate(6deg);
  }

  .final-cta-chip--oats {
    left: 15%;
    bottom: 25%;
    transform: rotate(8deg);
  }

  .final-cta-chip--yogurt {
    right: 18%;
    bottom: 20%;
    transform: rotate(-8deg);
  }

  @media (max-width: 640px) {
    .final-cta__actions {
      flex-direction: column;
      align-items: stretch;
    }
    
    .final-cta__button {
      width: 100%;
      min-width: 0;
    }
    
    .final-cta__decor {
      opacity: 0.35;
    }
    
    .final-cta__decor .food-chip {
      transform: none;
    }
  }
</style>
