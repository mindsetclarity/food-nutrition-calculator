---
---

<section class="py-24 bg-surface border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Visual Content -->
      <div class="order-2 lg:order-1 grid grid-cols-2 gap-4 animate-fade-up" style="animation-delay: 200ms;">
        <!-- Card 1 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-border flex flex-col justify-center items-center text-center shadow-sm hover-lift">
          <div class="text-3xl font-bold text-slate-800 mb-2">oz & lbs</div>
          <div class="text-sm text-muted font-medium">Standard Weights</div>
        </div>
        <!-- Card 2 -->
        <div class="bg-brand-50 rounded-2xl p-6 border border-brand-100 flex flex-col justify-center items-center text-center shadow-sm hover-lift mt-8">
          <div class="text-3xl font-bold text-brand-700 mb-2">cups</div>
          <div class="text-sm text-brand-600/80 font-medium">Volume Measurements</div>
        </div>
        <!-- Card 3 -->
        <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100 flex flex-col justify-center items-center text-center shadow-sm hover-lift -mt-8">
          <div class="text-3xl font-bold text-blue-800 mb-2">tbsp & tsp</div>
          <div class="text-sm text-blue-600/80 font-medium">Cooking Spoonfuls</div>
        </div>
        <!-- Card 4 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-border flex flex-col justify-center items-center text-center shadow-sm hover-lift">
          <div class="text-3xl font-bold text-slate-800 mb-2">slices</div>
          <div class="text-sm text-muted font-medium">Common Portions</div>
        </div>
      </div>

      <!-- Text Content -->
      <div class="order-1 lg:order-2 animate-fade-up">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-blue-50 text-blue-800 text-sm font-medium mb-6">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
          Made for the US
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-6 text-foreground">
          Designed for American foods and units
        </h2>
        <p class="text-lg text-muted leading-relaxed mb-8">
          Stop converting grams to ounces or liters to cups. Our calculator is built from the ground up to support the units and portion sizes you actually use in the kitchen.
        </p>
        
        <div class="space-y-6">
          <div class="flex">
            <div class="flex-shrink-0 mt-1">
              <svg class="w-6 h-6 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="ml-4">
              <h4 class="text-lg font-bold text-foreground">Standard US Measurements</h4>
              <p class="mt-1 text-muted">Seamlessly switch between ounces, pounds, cups, tablespoons, and teaspoons without doing mental math.</p>
            </div>
          </div>
          
          <div class="flex">
            <div class="flex-shrink-0 mt-1">
              <svg class="w-6 h-6 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="ml-4">
              <h4 class="text-lg font-bold text-foreground">Common Portions</h4>
              <p class="mt-1 text-muted">Select visual portions like slices, medium pieces, or standard servings for common American foods.</p>
            </div>
          </div>
          
          <div class="flex">
            <div class="flex-shrink-0 mt-1">
              <svg class="w-6 h-6 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="ml-4">
              <h4 class="text-lg font-bold text-foreground">Meal Versatility</h4>
              <p class="mt-1 text-muted">Perfect for logging breakfast, lunch, dinner, snacks, beverages, and tracking recipe ingredients accurately.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
