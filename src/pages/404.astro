---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found - Food Nutrition Calculator">
  <main class="max-w-2xl mx-auto p-4 sm:p-6 text-center space-y-8 flex flex-col items-center justify-center min-h-[60vh]">
    <h1 class="text-8xl md:text-9xl font-bold text-gray-200">404</h1>
    <h2 class="text-3xl font-bold text-gray-900 mt-4">Page Not Found</h2>
    <p class="text-gray-600 max-w-md mx-auto">
      Sorry, we couldn't find the page you're looking for. It might have been moved, deleted, or perhaps the URL is incorrect.
    </p>
    <a href="/" class="inline-block bg-blue-600 text-white font-medium py-3 px-8 rounded-lg shadow hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors mt-8">
      Return Home
    </a>
  </main>
</Layout>
