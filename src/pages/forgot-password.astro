---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import { findUserByEmail } from '../lib/community/users';
import { createEmailToken } from '../lib/community/tokens';
import { sendEmail } from '../lib/community/email';

export const prerender = false;

let error = '';
let sent = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const ip = Astro.request.headers.get('CF-Connecting-IP');

  const limit = await env.AUTH_LIMITER?.limit({ key: ip ?? 'unknown' });
  if (limit && !limit.success) {
    error = 'Too many attempts. Please wait a minute.';
  } else {
    const user = await findUserByEmail(env.DB, email);
    if (user) {
      const link = `${Astro.url.origin}/reset-password?token=${await createEmailToken(env.DB, user.id, 'reset')}`;
      await sendEmail(env.RESEND_API_KEY, {
        to: user.email,
        subject: 'Reset your password',
        text: `Reset your Food Nutrition Calculator password: ${link}\n\nThis link works for 1 hour. If you did not ask for it, ignore this email.`,
      });
    }
    // Same answer whether or not the account exists.
    sent = true;
  }
}
const field = 'w-full px-4 py-2 rounded-lg border border-border-soft focus:outline-none focus:ring-2 focus:ring-usda-emerald/50';
---
<SiteLayout title="Forgot password | Food Nutrition Calculator" description="Reset your community password." noindex>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-black text-ink-navy text-center mb-8">Forgot password</h1>
    {sent ? (
      <p role="status" class="max-w-md mx-auto text-center text-ink-navy">If that email has an account, we sent a link to reset the password.</p>
    ) : (
      <form method="POST" class="bg-white border border-border-soft p-6 rounded-2xl shadow-sm flex flex-col gap-4 max-w-md mx-auto">
        {error && <p role="alert" class="p-3 rounded-md bg-danger-bg text-danger-text text-sm">{error}</p>}
        <div class="flex flex-col gap-1">
          <label for="email" class="text-sm font-medium text-ink-navy">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" class={field} required />
        </div>
        <button type="submit" class="bg-usda-emerald hover:bg-emerald-700 text-white shadow-premium rounded-lg px-4 py-2 font-medium">Send reset link</button>
      </form>
    )}
  </main>
</SiteLayout>
