---
import TrustPageShell from '../components/trust/TrustPageShell.astro';
import TrustTOC from '../components/trust/TrustTOC.astro';
import TrustCard from '../components/trust/TrustCard.astro';
import TrustBulletList from '../components/trust/TrustBulletList.astro';
import TrustBulletListItem from '../components/trust/TrustBulletListItem.astro';
import TrustProcessSteps from '../components/trust/TrustProcessSteps.astro';

const badges = [
  "Deterministic totals",
  "USDA-first where available",
  "Reviewable inputs",
  "Estimates, not medical advice"
];

const toc = [
  { id: "quick-summary", label: "Quick summary" },
  { id: "calculation-pipeline", label: "Calculation pipeline" },
  { id: "core-calculation", label: "Core calculation" },
  { id: "unit-handling", label: "Quantity and units" },
  { id: "complex-calculations", label: "Recipes and meals" },
  { id: "ai-boundary", label: "AI parsing boundary" },
  { id: "missing-data", label: "Missing data handling" }
];
---
<TrustPageShell showCta={false}
  title="Methodology | How Food Nutrition Calculator Estimates Nutrition"
  description="A transparent look at how foods are searched, matched, converted into quantities, and calculated into source-labeled nutrition estimates."
  eyebrow="Methodology"
  badges={badges}
>

  <TrustTOC sections={toc} />

  <h2 id="quick-summary">Quick summary</h2>
  <TrustCard title="How we estimate nutrition">
    <p>We use a deterministic math engine to calculate nutrition based on resolved food data.</p>
    <TrustBulletList>
      <TrustBulletListItem>User enters a food, meal, or recipe.</TrustBulletListItem>
      <TrustBulletListItem>The system searches for matching food data.</TrustBulletListItem>
      <TrustBulletListItem>USDA data is prioritized when available.</TrustBulletListItem>
      <TrustBulletListItem>Local fallback data is used when USDA is unavailable.</TrustBulletListItem>
      <TrustBulletListItem>Quantity and serving units are converted into calculation amounts.</TrustBulletListItem>
      <TrustBulletListItem>The deterministic nutrition engine calculates final totals.</TrustBulletListItem>
      <TrustBulletListItem>AI may help parse text but does not calculate final nutrition values.</TrustBulletListItem>
    </TrustBulletList>
  </TrustCard>

  <h2 id="calculation-pipeline">The calculation pipeline</h2>
  <p>Our system follows a strict, step-by-step pipeline to ensure predictability and mathematical accuracy:</p>
  <TrustProcessSteps />

  <h2 id="core-calculation">The core calculation</h2>
  <p>For each food, nutrition is estimated from the selected source and adjusted by amount. Once a food and its target weight in grams are established, we use a simple, predictable formula to determine the nutrients:</p>
  
  <div class="bg-slate-800 text-white p-6 rounded-2xl my-6 font-mono text-sm overflow-x-auto shadow-ink">
    <p class="m-0 text-emerald-400 font-bold mb-2">// Deterministic Formula</p>
    <code class="text-[15px]">amount_in_grams ÷ 100 × nutrient_value_per_100g</code>
  </div>

  <TrustBulletList>
    <TrustBulletListItem><strong>Calories, macros, and nutrients:</strong> Calculated directly from resolved food data.</TrustBulletListItem>
    <TrustBulletListItem><strong>Recipe totals:</strong> Summed up from the individual ingredient calculations.</TrustBulletListItem>
    <TrustBulletListItem><strong>Per-serving recipe values:</strong> Calculated by dividing the totals by the specified serving count.</TrustBulletListItem>
    <TrustBulletListItem><strong>Meal totals:</strong> Calculated by summing foods inside specific meal sections.</TrustBulletListItem>
    <TrustBulletListItem><strong>Compare pages:</strong> Compare resolved foods on a consistent basis (per 100g or per serving).</TrustBulletListItem>
  </TrustBulletList>

  <h2 id="unit-handling">Handling quantities and units</h2>
  <p>Calculations are inherently based on weight. When you select a volume measurement, the system handles it with specific rules:</p>
  <TrustBulletList class="bg-white border border-border-soft p-6 rounded-2xl">
    <TrustBulletListItem><strong>Grams:</strong> The most consistent basis for all calculations.</TrustBulletListItem>
    <TrustBulletListItem><strong>Ounces and pounds:</strong> Can be converted to grams consistently.</TrustBulletListItem>
    <TrustBulletListItem><strong>Cups, tablespoons, pieces, and servings:</strong> Depend heavily on the specific food (e.g., a cup of spinach weighs much less than a cup of peanut butter).</TrustBulletListItem>
    <TrustBulletListItem><strong>Variability:</strong> Serving weights may vary by brand, density, and preparation.</TrustBulletListItem>
    <TrustBulletListItem><strong>Unsupported units:</strong> If a volume conversion is missing, the app will ask the user to review or choose a weight-based unit.</TrustBulletListItem>
  </TrustBulletList>

  <h2 id="complex-calculations">Recipe, meal, and compare calculations</h2>
  <p>Our engine scales up the deterministic math for more complex tools.</p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-8">
    <TrustCard title="Recipe calculations">
      <p>Every single ingredient is resolved and calculated independently. The engine then sums the individual nutrient values together and divides by the serving count.</p>
    </TrustCard>
    <TrustCard title="Meal calculations">
      <p>Foods are added into logical meal groups. The system totals the individual items to produce a full-day plate estimate.</p>
    </TrustCard>
    <TrustCard title="Compare calculations">
      <p>Two distinct food items are pulled, normalized to a 100g basis (or single serving), and placed side-by-side without mathematical bias.</p>
    </TrustCard>
  </div>

  <h2 id="ai-boundary">What AI can and cannot do</h2>
  <p>To avoid hallucinations, we enforce a strict AI boundary.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
    <TrustCard title="Can do" icon="✓">
      <TrustBulletList>
        <TrustBulletListItem>Parse messy text and ingredient lists</TrustBulletListItem>
        <TrustBulletListItem>Identify likely food names</TrustBulletListItem>
        <TrustBulletListItem>Suggest search queries</TrustBulletListItem>
        <TrustBulletListItem>Help split recipe ingredients and quantities</TrustBulletListItem>
      </TrustBulletList>
    </TrustCard>
    <TrustCard title="Cannot do" icon="✗">
      <TrustBulletList>
        <TrustBulletListItem>Own or guess final calories</TrustBulletListItem>
        <TrustBulletListItem>Override USDA or local nutrition data</TrustBulletListItem>
        <TrustBulletListItem>Invent verified nutrition values</TrustBulletListItem>
        <TrustBulletListItem>Replace user review</TrustBulletListItem>
        <TrustBulletListItem>Provide medical advice</TrustBulletListItem>
      </TrustBulletList>
    </TrustCard>
  </div>

  <h2 id="missing-data">Missing and partial data handling</h2>
  <p>Not every database entry contains a full profile of micronutrients. We handle missing data transparently.</p>
  <TrustBulletList class="bg-white border border-border-soft p-6 rounded-2xl">
    <TrustBulletListItem>Some food sources do not include every nutrient (e.g., specific vitamins).</TrustBulletListItem>
    <TrustBulletListItem>Missing nutrients may appear as "—" rather than a false "0".</TrustBulletListItem>
    <TrustBulletListItem>Partial data warnings are shown when needed to prevent false confidence.</TrustBulletListItem>
    <TrustBulletListItem>Unknown values are not treated as verified values.</TrustBulletListItem>
    <TrustBulletListItem>Users should review source labels and warnings before relying on specific micronutrient totals.</TrustBulletListItem>
  </TrustBulletList>

</TrustPageShell>
