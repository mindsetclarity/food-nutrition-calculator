---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHeader from '../../../components/site/PageHeader.astro';
import Button from '../../../components/ui/Button.astro';
import ReplyList from '../../../components/community/ReplyList.astro';
import Disclaimer from '../../../components/community/Disclaimer.astro';
import { TOPICS } from '../../../lib/community/db';
import { canWrite } from '../../../lib/community/users';
import { getPost, listReplies, createReply, postUrl } from '../../../lib/community/posts';

export const prerender = false;

const topic = TOPICS.find((t) => t.slug === Astro.params.topic);
const id = Number(/^(\d+)-/.exec(Astro.params.post ?? '')?.[1]);
const post = topic && Number.isSafeInteger(id) ? await getPost(env.DB, id) : null;
if (!topic || !post || post.deleted_at || post.author_banned) return new Response(null, { status: 404 });
const canonical = postUrl(post);
if (Astro.url.pathname !== canonical) return Astro.redirect(canonical, 301);

const user = Astro.locals.user;
let error = '';
let reply = '';
if (Astro.request.method === 'POST') {
  reply = String((await Astro.request.formData()).get('body') ?? '');
  const r = user ? await createReply(env.DB, user, post.id, reply) : ({ ok: false, error: 'Please sign in to reply.' } as const);
  if (r.ok) return Astro.redirect(`${canonical}#reply-${r.id}`, 303);
  error = r.error;
}
const replies = await listReplies(env.DB, post.id);
const description = post.body.replace(/\s+/g, ' ').trim().slice(0, 155);
const field = 'w-full px-4 py-2 rounded-lg border border-border-soft focus:outline-none focus:ring-2 focus:ring-usda-emerald/50';
---
<SiteLayout title={`${post.title} | Community`} description={description} canonicalPath={canonical} noindex={!topic.indexable}>
  <PageHeader title={post.title} description={`by ${post.username} · ${new Date(post.created_at).toISOString().slice(0, 10)}`} breadcrumbs={[{ label: 'Community', href: '/community' }, { label: topic.label, href: `/community/${topic.slug}` }, { label: post.title }]} />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <article class="bg-white border border-border-soft rounded-xl p-5 mb-8">
      <div class="text-ink-navy" style="white-space: pre-wrap; overflow-wrap: anywhere;">{post.body}</div>
    </article>
    <h2 class="text-xl font-bold text-ink-navy mb-4">{replies.length} {replies.length === 1 ? 'reply' : 'replies'}</h2>
    <ReplyList replies={replies} />
    <div class="mt-8">
      {user && canWrite(user) ? (
        <form method="POST" action={canonical} class="flex flex-col gap-3">
          {error && <p role="alert" class="p-3 rounded-md bg-danger-bg text-danger-text text-sm">{error}</p>}
          <label for="body" class="text-sm font-medium text-ink-navy">Your reply</label>
          <textarea id="body" name="body" rows="4" minlength="2" maxlength="2000" class={field} required>{reply}</textarea>
          <div><Button type="submit">Reply</Button></div>
        </form>
      ) : user ? (
        <p class="text-sm text-soft-slate">{user.is_banned ? 'Your account cannot post replies.' : <>Choose a username in <a href="/welcome" class="text-usda-emerald underline">your account setup</a> to reply.</>}</p>
      ) : (
        <Button href="/login">Sign in to post</Button>
      )}
    </div>
    <Disclaimer />
  </main>
</SiteLayout>
