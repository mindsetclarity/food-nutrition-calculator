---
import '../styles/global.css';
import MotionObserver from '../components/site/MotionObserver.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import Fonts from '../components/site/Fonts.astro';
import type { JsonLdSchema } from '../lib/seo/types';

interface Props {
	title?: string;
	description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: string;
  ogImage?: string;
  keywords?: string;
  jsonLd?: JsonLdSchema | JsonLdSchema[];
}

const { 
	title,
	description,
  canonicalPath = Astro.url.pathname,
  noindex,
  ogType,
  ogImage,
  keywords,
  jsonLd
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="FNC" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<SeoHead 
      title={title} 
      description={description} 
      canonicalPath={canonicalPath} 
      noindex={noindex} 
      ogType={ogType} 
      ogImage={ogImage}
      keywords={keywords}
      jsonLd={jsonLd} 
    />

		<Fonts />
	</head>
	<body class="bg-[var(--color-canvas-soft)] text-[var(--color-ink)] min-h-screen flex flex-col no-body-overflow-guard">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-brand-600 focus-ring rounded-md m-4 shadow-premium">
			Skip to content
		</a>
		<Header />
		<slot />
		<Footer />
		<MotionObserver />
		<div id="a11y-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>
	</body>
</html>
