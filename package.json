{
  "name": "foodnutritioncalculator.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "node scripts/deploy.mjs",
    "test:nemotron": "node --experimental-strip-types scripts/test-nemotron.mjs",
    "test:usda": "node --experimental-strip-types scripts/test-usda-normalize.mjs",
    "test:meal-parser": "node --experimental-strip-types scripts/test-basic-meal-parser.mjs && node --experimental-strip-types scripts/test-normalize-parsed-meal.mjs",
    "test:ranking": "node --experimental-strip-types scripts/test-usda-ranking.mjs",
    "test:llm-client": "node --experimental-strip-types scripts/test-llm-client.mjs",
    "test:escape-html": "node --experimental-strip-types scripts/test-escape-html.mjs",
    "test:seo-paths": "node --experimental-strip-types scripts/test-seo-paths.mjs",
    "test:byte-range": "node --experimental-strip-types scripts/test-byte-range.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:notes": "node --experimental-strip-types scripts/test-editorial-notes.mjs",
    "prebuild": "npm run -s test:notes && npm run -s test:categories && npm run -s test:energy && npm run -s test:embed && npm run -s test:resolve-food && npm run -s test:cleanup-sitemap && npm run -s test:body-metrics && npm run -s test:topic-clusters",
    "test:energy": "node --experimental-strip-types scripts/test-energy.mjs",
    "test:categories": "node --experimental-strip-types scripts/test-categories.mjs",
    "test:embed": "node --experimental-strip-types scripts/test-embed.mjs",
    "test:resolve-food": "node --experimental-strip-types scripts/test-resolve-food.mjs",
    "test:cleanup-sitemap": "node --experimental-strip-types scripts/test-cleanup-sitemap.mjs",
    "test:body-metrics": "node --experimental-strip-types scripts/test-body-metrics.mjs",
    "test:topic-clusters": "node --experimental-strip-types scripts/test-topic-clusters.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.1.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "wrangler": "^4.103.0"
  }
}
